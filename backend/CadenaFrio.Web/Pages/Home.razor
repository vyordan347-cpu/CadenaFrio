@page "/"
@using System.Net.Http.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Componentes
@using CadenaFrio.Web.Utilidades
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

@* El título de la pestaña avisa de las rupturas aunque la ventana esté minimizada. *@
<PageTitle>@TituloPestana</PageTitle>

<main class="pagina">
    @if (Aviso == "contrasena")
    {
        <p class="aviso aviso-ok aviso-con-icono aviso-superior">
            <Icono Nombre="check" Tamano="18" /> Su contraseña se cambió correctamente.
        </p>
    }

    <header class="encabezado">
        <div class="encabezado-texto">
            <h1>Centro de monitoreo</h1>
            <p class="subtitulo cifras">
                @if (ultimaActualizacion is { } u)
                {
                    <span>Actualizado a las @FormatoFecha.HoraPeru(u)[11..] · </span>
                }
                <span>Se actualiza cada 10 segundos</span>
            </p>
        </div>

        <div class="herramientas">
            <button class="boton boton-chico @(sonidoActivo ? "activo" : "")" @onclick="AlternarSonidoAsync"
                    aria-pressed="@(sonidoActivo ? "true" : "false")"
                    title="Suena una alarma cuando un equipo entra en ruptura o pierde la señal">
                <Icono Nombre="campana" Tamano="16" /> @(sonidoActivo ? "Sonido activado" : "Activar sonido")
            </button>
            <button class="boton boton-chico" @onclick="AlternarPantallaCompletaAsync">
                <Icono Nombre="@(pantallaCompleta ? "minimizar" : "maximizar")" Tamano="16" /> @(pantallaCompleta ? "Salir de pantalla completa" : "Pantalla completa")
            </button>
        </div>
    </header>

    @* Sin conexión: se avisa, pero se siguen mostrando los últimos datos recibidos. *@
    @if (error is not null)
    {
        <p class="aviso aviso-error aviso-con-icono aviso-superior" role="alert">
            <Icono Nombre="sin-senal" Tamano="18" />
            <span>Sin conexión con el servidor. Se reintentará en unos segundos@(estados is null ? "." : "; los datos de abajo pueden no estar al día.")</span>
        </p>
    }

    @* Estado actual: cuántos equipos hay en cada situación y cuántas alertas esperan revisión. *@
    @if (estados is { Count: > 0 })
    {
        <section class="resumen" aria-label="Estado actual de los equipos">
            @foreach (var grupo in Resumen)
            {
                <div class="resumen-item estado-@grupo.Clase @(grupo.Cantidad == 0 ? "cero" : "")">
                    <span class="resumen-icono"><Icono Nombre="@grupo.Icono" Tamano="20" /></span>
                    <strong class="resumen-cifra cifras">@grupo.Cantidad</strong>
                    <span class="resumen-texto">@grupo.Texto</span>
                </div>
            }
        </section>
    }

    <div class="monitoreo">
        <section class="equipos" aria-label="Equipos">
            @if (estados is null && error is null)
            {
                @* Mientras carga: el lugar de las tarjetas, sin saltos cuando llegan los datos. *@
                @for (var i = 0; i < 2; i++)
                {
                    <div class="tarjeta equipo esqueleto-tarjeta" aria-hidden="true">
                        <span class="esqueleto" style="width: 60%; height: 1.2rem"></span>
                        <span class="esqueleto" style="height: 9rem"></span>
                        <span class="esqueleto" style="width: 80%"></span>
                    </div>
                }
                <p class="solo-lector" role="status">Cargando equipos…</p>
            }
            else if (estados is { Count: 0 })
            {
                <div class="tarjeta estado-vacio">
                    <Icono Nombre="refrigeradora" Tamano="36" />
                    <h2>No hay equipos activos</h2>
                    <p>El administrador puede registrarlos en <a href="admin/equipos">Administración → Equipos</a>.</p>
                </div>
            }
            else if (estados is not null)
            {
                @* Una tarjeta por equipo, los que tienen problemas primero. *@
                @foreach (var (equipo, vista) in Ordenados)
                {
                    var antigua = EstadoEquipo.LecturaAntigua(equipo);
                    var termico = EstadoEquipo.Termico(equipo);
                    var comunicacion = EstadoEquipo.Comunicacion(equipo);
                    <article class="tarjeta equipo borde-@vista.Clase @(antigua ? "antigua" : "")" aria-labelledby="equipo-@equipo.EquipoId">
                        <header class="equipo-cabecera">
                            <span class="equipo-icono">
                                <Icono Nombre="@(equipo.TipoEquipo == TipoEquipoDto.Termo ? "termo" : "refrigeradora")" Tamano="20" />
                            </span>
                            <div class="equipo-texto">
                                <h2 class="equipo-nombre" id="equipo-@equipo.EquipoId">@equipo.NombreEquipo</h2>
                                <p class="equipo-lugar">@(string.IsNullOrWhiteSpace(equipo.Ubicacion) ? (equipo.TipoEquipo == TipoEquipoDto.Termo ? "Termo portavacunas" : "Refrigeradora") : equipo.Ubicacion)</p>
                            </div>
                            @* Con lectura antigua, la insignia va con borde discontinuo y dice de cuándo es. *@
                            <span class="insignia insignia-@termico.Clase @(antigua ? "insignia-antigua" : "")"
                                  title="@(antigua ? "Estado térmico de la última lectura conocida" : "Estado térmico")">
                                <Icono Nombre="@termico.Icono" Tamano="14" /> @termico.Texto
                                @if (EstadoEquipo.Antiguedad(equipo) is { } hace)
                                {
                                    <span class="insignia-cuando">· @hace</span>
                                }
                            </span>
                        </header>

                        <div class="equipo-cuerpo">
                            @* Con la lectura antigua, el medidor se atenúa y no pulsa: no es una medición en vivo. *@
                            <div class="equipo-medidor">
                                <IndicadorTemperatura Compacto="true" Temperatura="equipo.Temperatura"
                                                      OptimoMinimo="equipo.OptimoMinimo" OptimoMaximo="equipo.OptimoMaximo"
                                                      LimiteMinimo="equipo.LimiteMinimo" LimiteMaximo="equipo.LimiteMaximo"
                                                      Estado="@vista.Clase" TextoEstado="@vista.Estado" />
                                @if (antigua && equipo.Temperatura is not null)
                                {
                                    <span class="sello-antiguo"><Icono Nombre="reloj" Tamano="14" /> Última conocida</span>
                                }
                            </div>

                            <dl class="equipo-datos">
                                @* Comunicación y última lectura juntas: responden la misma pregunta
                                   (¿la temperatura de la aguja es de ahora?). *@
                                <div>
                                    <dt>Comunicación</dt>
                                    <dd class="cifras">
                                        <span class="insignia insignia-@comunicacion.Clase">
                                            <Icono Nombre="@comunicacion.Icono" Tamano="14" /> @comunicacion.Texto
                                        </span>
                                        @if (equipo.FechaMedicion is { } f)
                                        {
                                            <span class="@(antigua ? "dato-antiguo" : "")" title="@FormatoFecha.HoraPeru(f)[..16]">
                                                <span class="solo-lector">Última lectura </span>@FormatoFecha.Antiguedad(f)
                                            </span>
                                            @* La fecha exacta solo importa si la lectura es antigua. *@
                                            @if (antigua)
                                            {
                                                <span class="dato-secundario">@FormatoFecha.HoraPeru(f)[..16]</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>Todavía no hay lecturas</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt>Rango permitido</dt>
                                    <dd class="cifras">
                                        <span>Óptimo @equipo.OptimoMinimo.ToString("0.#")–@equipo.OptimoMaximo.ToString("0.#") °C</span>
                                        <span class="dato-secundario">Límite @equipo.LimiteMinimo.ToString("0.#")–@equipo.LimiteMaximo.ToString("0.#") °C</span>
                                    </dd>
                                </div>
                                <div>
                                    <dt>Última hora</dt>
                                    <dd>
                                        @if (!antigua && Tendencia(equipo.Recientes) is { } tendencia)
                                        {
                                            <span class="tendencia-texto @tendencia.Clase">@tendencia.Texto</span>
                                            <MiniGrafico Valores="equipo.Recientes" />
                                        }
                                        else
                                        {
                                            <span class="dato-secundario">Sin datos recientes</span>
                                        }
                                    </dd>
                                </div>
                            </dl>
                        </div>

                        <p class="equipo-accion accion-@vista.Clase">@vista.Accion</p>

                        @if (equipo.AlertaUrgente is { } urgente)
                        {
                            <p class="equipo-atencion @(urgente.ReconocidaPor is null ? "sin-atender" : "")">
                                <Icono Nombre="atendiendo" Tamano="16" />
                                @(urgente.ReconocidaPor is null ? "Nadie la está atendiendo" : $"Atendiendo: {urgente.ReconocidaPor}")
                            </p>
                        }

                        @* El enlace cubre toda la tarjeta: se puede tocar en cualquier parte. *@
                        <a class="ver-detalle" href="equipos/@equipo.EquipoId">
                            Ver detalle<span class="solo-lector"> de @equipo.NombreEquipo</span> <Icono Nombre="abajo" Tamano="16" Clase="flecha" />
                        </a>
                    </article>
                }
            }
        </section>

        @* Alertas por revisar de todos los equipos (RF08). Se revisan en el detalle de cada equipo. *@
        <aside class="columna-alertas" aria-labelledby="titulo-eventos">
            <header class="eventos-cabecera">
                <span class="eventos-icono"><Icono Nombre="campana" /></span>
                <h2 id="titulo-eventos">Alertas por revisar</h2>
                @if (pendientes.Count > 0)
                {
                    <span class="contador cifras">@pendientes.Count</span>
                }
            </header>

            @if (pendientes.Count == 0)
            {
                <p class="sin-pendientes"><Icono Nombre="ok" Tamano="18" /> No hay alertas por revisar.</p>
            }
            else
            {
                @* Solo las más urgentes; la lista completa, con filtros, está en Alertas. *@
                <ul class="lista-pendientes">
                    @foreach (var pendiente in PendientesVisibles)
                    {
                        var silencio = pendiente.Tipo == TipoAlertaDto.SinSenal;
                        <li>
                            <a class="pendiente @(silencio ? "pendiente-sen" : "pendiente-rup")" href="equipos/@pendiente.EquipoId">
                                <span class="pendiente-icono">
                                    <Icono Nombre="@(silencio ? "sin-senal" : "ruptura")" Tamano="16" />
                                </span>
                                <span class="pendiente-texto">
                                    <span class="pendiente-titulo">@pendiente.NombreEquipo</span>
                                    <span class="pendiente-linea cifras">
                                        <span class="pendiente-tipo">@(silencio ? "Silencio prolongado" : "Ruptura")</span>
                                        · desde @FormatoFecha.HoraPeru(pendiente.Inicio)[..16]@(pendiente.DetectadaTarde ? " · detectada al sincronizar" : "")
                                    </span>
                                    @if (pendiente.FechaLimiteNotificacion is { } limite)
                                    {
                                        var restante = limite - DateTime.UtcNow;
                                        <span class="pendiente-plazo @(restante > TimeSpan.Zero ? "plazo-vigente" : "plazo-vencido")">
                                            <Icono Nombre="reloj" Tamano="14" />
                                            @(restante > TimeSpan.Zero ? $"Notificar en {FormatoFecha.Duracion(restante)}" : $"Plazo vencido hace {FormatoFecha.Duracion(-restante)}")
                                        </span>
                                    }
                                </span>
                                <span class="pendiente-ir">
                                    <span class="solo-lector">Revisar</span>
                                    <Icono Nombre="abajo" Tamano="18" Clase="flecha" />
                                </span>
                            </a>
                        </li>
                    }
                </ul>

                <a class="ver-todas" href="alertas">
                    @(pendientes.Count > MaximoPendientesVisibles
                        ? $"Ver las {pendientes.Count} en Alertas"
                        : "Abrir el centro de alertas")
                    <Icono Nombre="abajo" Tamano="16" Clase="flecha" />
                </a>
            }
        </aside>
    </div>
</main>

@code {
    // Aviso que llega en la dirección, por ejemplo después de cambiar la contraseña.
    [SupplyParameterFromQuery]
    public string? Aviso { get; set; }

    private static readonly TimeSpan IntervaloActualizacion = TimeSpan.FromSeconds(10);

    private List<TemperaturaActualDto>? estados;

    // Avisos: sonido, pantalla completa y equipos que ya estaban en estado grave.
    private IJSObjectReference? avisos;
    private bool sonidoActivo;
    private bool pantallaCompleta;
    private HashSet<int>? equiposGraves;
    private List<AlertaPendienteDto> pendientes = new();
    private string? error;

    // Hora (UTC) de la última carga correcta, para mostrar qué tan al día está el panel.
    private DateTime? ultimaActualizacion;
    private readonly CancellationTokenSource cancelacion = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        _ = ActualizarPeriodicamenteAsync();
    }

    private async Task ActualizarPeriodicamenteAsync()
    {
        using var temporizador = new PeriodicTimer(IntervaloActualizacion);
        try
        {
            while (await temporizador.WaitForNextTickAsync(cancelacion.Token))
            {
                await CargarAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Dos peticiones para todo el panel, sin importar cuántos equipos haya.
    private async Task CargarAsync()
    {
        try
        {
            estados = await Http.GetFromJsonAsync<List<TemperaturaActualDto>>("api/equipos/estado", cancelacion.Token);
            pendientes = await Http.GetFromJsonAsync<List<AlertaPendienteDto>>("api/alertas/pendientes", cancelacion.Token) ?? new();
            error = null;
            ultimaActualizacion = DateTime.UtcNow;
            await AvisarSiHayNuevosProblemasAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    // Los equipos con problemas primero; a igual gravedad, por nombre.
    private IEnumerable<(TemperaturaActualDto Equipo, VistaEstado Vista)> Ordenados =>
        estados!
            .Select(e => (Equipo: e, Vista: EstadoEquipo.Calcular(e)))
            .OrderByDescending(x => x.Vista.Gravedad)
            .ThenBy(x => x.Equipo.NombreEquipo);

    // Columna de alertas del panel: las 5 más urgentes. Primero las rupturas cuyo plazo de
    // notificación (Anexo 13) sigue corriendo, la más próxima a vencer arriba; después el resto,
    // de la más reciente a la más antigua. Solo cambia el orden en pantalla, no qué se revisa.
    private const int MaximoPendientesVisibles = 5;

    private IEnumerable<AlertaPendienteDto> PendientesVisibles
    {
        get
        {
            var ahora = DateTime.UtcNow;
            return pendientes
                .OrderBy(p => p.FechaLimiteNotificacion is { } l && l > ahora ? 0 : 1)
                .ThenBy(p => p.FechaLimiteNotificacion is { } l && l > ahora ? l : DateTime.MaxValue)
                .ThenByDescending(p => p.Inicio)
                .Take(MaximoPendientesVisibles);
        }
    }

    private record GrupoResumen(string Clase, string Icono, string Texto, int Cantidad);

    // Se muestran siempre los cinco, también en cero: la fila no cambia de forma entre actualizaciones.
    // Estado térmico y comunicación se cuentan por separado: un equipo en ruptura que además
    // perdió la señal aparece en las dos cifras.
    private IEnumerable<GrupoResumen> Resumen
    {
        get
        {
            var termicos = estados!.Select(EstadoEquipo.Termico).ToList();
            var sinComunicacion = estados!.Count(e => EstadoEquipo.Comunicacion(e).Clase != "ok");
            var normales = estados!.Count(e => EstadoEquipo.Termico(e).Clase == "ok" && EstadoEquipo.Comunicacion(e).Clase == "ok");
            return new[]
            {
                new GrupoResumen("rup", "ruptura", "en ruptura", termicos.Count(t => t.Clase == "rup")),
                new GrupoResumen("sen", "sin-senal", "sin señal o retrasados", sinComunicacion),
                new GrupoResumen("adv", "advertencia", "en advertencia", termicos.Count(t => t.Clase == "adv")),
                new GrupoResumen("ok", "ok", normales == 1 ? "normal y en línea" : "normales y en línea", normales),
                new GrupoResumen("pendientes", "campana", pendientes.Count == 1 ? "alerta por revisar" : "alertas por revisar", pendientes.Count)
            };
        }
    }

    // ---------- Tendencia de cada tarjeta ----------

    private record InfoTendencia(string Texto, string Clase);

    private static InfoTendencia? Tendencia(List<double> recientes)
    {
        if (recientes.Count < 2)
        {
            return null;
        }

        var diferencia = recientes[^1] - recientes[^2];
        if (Math.Abs(diferencia) < 0.05)
        {
            return new("● estable", "estable");
        }

        return diferencia > 0
            ? new($"▲ subiendo {diferencia:0.0}°", "sube")
            : new($"▼ bajando {Math.Abs(diferencia):0.0}°", "baja");
    }

    // ---------- Avisos ----------

    // Título de la pestaña: muestra los problemas aunque la ventana esté minimizada.
    private string TituloPestana
    {
        get
        {
            var vistas = estados?.Select(EstadoEquipo.Calcular).ToList() ?? new();
            var rupturas = vistas.Count(v => v.Clase == "rup");
            var sinSenal = vistas.Count(v => v.Estado == "Sin señal");

            return rupturas > 0 ? $"({rupturas}) ¡Ruptura! · Cadena de Frío"
                : sinSenal > 0 ? $"({sinSenal}) Sin señal · Cadena de Frío"
                : "Panel · Cadena de Frío";
        }
    }

    // Si un equipo acaba de entrar en ruptura o perder la señal, suena la alarma.
    // La primera carga no suena: solo se avisa de lo que cambia mientras el panel está abierto.
    private async Task AvisarSiHayNuevosProblemasAsync()
    {
        var graves = estados!
            .Where(e => EstadoEquipo.Calcular(e).Gravedad >= 4)
            .Select(e => e.EquipoId)
            .ToHashSet();

        var hayNuevos = equiposGraves is not null && graves.Except(equiposGraves).Any();
        equiposGraves = graves;

        if (hayNuevos && sonidoActivo && avisos is not null)
        {
            await avisos.InvokeAsync<bool>("sonarAlarma");
        }
    }

    private async Task<IJSObjectReference> ModuloAvisosAsync() =>
        avisos ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/avisos.js?v=1");

    private async Task AlternarSonidoAsync()
    {
        try
        {
            if (sonidoActivo)
            {
                sonidoActivo = false;
                return;
            }

            // Este clic habilita el audio del navegador y suena un pitido de prueba.
            sonidoActivo = await (await ModuloAvisosAsync()).InvokeAsync<bool>("activarSonido");
        }
        catch (JSException)
        {
            sonidoActivo = false;
        }
    }

    private async Task AlternarPantallaCompletaAsync()
    {
        try
        {
            pantallaCompleta = await (await ModuloAvisosAsync()).InvokeAsync<bool>("alternarPantallaCompleta");
        }
        catch (JSException)
        {
            pantallaCompleta = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();

        if (avisos is not null)
        {
            try
            {
                await avisos.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
