@page "/"
@using System.Net.Http.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Utilidades
@inject HttpClient Http
@implements IDisposable

<PageTitle>Cadena de frío - Temperatura actual</PageTitle>

<main class="contenedor">
    @if (error is not null)
    {
        <div class="tarjeta estado-error">
            <p class="equipo">No se pudo obtener la temperatura</p>
            <p class="detalle">Revise que el servidor esté en funcionamiento. Se reintentará en unos segundos.</p>
        </div>
    }
    else if (datos is null)
    {
        <p class="cargando">Cargando…</p>
    }
    else
    {
        <div class="tarjeta @ClaseEstado">
            <p class="equipo">@datos.NombreEquipo</p>

            @if (datos.Estado == EstadoLectura.SinDatos)
            {
                <p class="temperatura">-- °C</p>
                <p class="estado">Sin datos</p>
                <p class="detalle">Este equipo todavía no ha enviado lecturas.</p>
            }
            else
            {
                <p class="temperatura">@datos.Temperatura?.ToString("0.0") °C</p>
                <p class="estado">@TextoEstado</p>

                @if (datos.AlertaActiva is { } alerta)
                {
                    @* Detalle de la alerta activa (HU03). *@
                    <div class="alerta-detalle">
                        <p>
                            Alerta desde @FormatoFecha.HoraPeru(alerta.Inicio)
                            (@FormatoFecha.Antiguedad(alerta.Inicio))
                        </p>
                        <p>
                            @(alerta.Tipo == TipoAlertaDto.TemperaturaAlta ? "Máxima" : "Mínima") registrada:
                            @alerta.ValorExtremo.ToString("0.0") °C
                        </p>
                    </div>
                }

                <p class="detalle">
                    Última lectura: @FormatoFecha.HoraPeru(datos.FechaMedicion!.Value)
                    (@FormatoFecha.Antiguedad(datos.FechaMedicion.Value))
                </p>
            }

            <p class="rango">
                Rango permitido: @datos.RangoMinimo.ToString("0.0") °C a @datos.RangoMaximo.ToString("0.0") °C
            </p>
        </div>
    }

    <p class="pie">Se actualiza automáticamente cada 10 segundos.</p>
</main>

@code {
    // Por ahora la pantalla muestra el equipo de prueba.
    // En el Sprint 6 (dashboard) se mostrarán todos los equipos.
    private const int EquipoId = 1;

    private static readonly TimeSpan IntervaloActualizacion = TimeSpan.FromSeconds(10);

    private TemperaturaActualDto? datos;
    private string? error;
    private readonly CancellationTokenSource cancelacion = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();

        // Inicia la actualización periódica sin bloquear la primera carga de la página.
        _ = ActualizarPeriodicamenteAsync();
    }

    private async Task ActualizarPeriodicamenteAsync()
    {
        using var temporizador = new PeriodicTimer(IntervaloActualizacion);
        try
        {
            while (await temporizador.WaitForNextTickAsync(cancelacion.Token))
            {
                await CargarAsync();
                // Pide a Blazor que vuelva a dibujar la pantalla con los datos nuevos.
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // El usuario salió de la página: se detiene la actualización.
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            datos = await Http.GetFromJsonAsync<TemperaturaActualDto>(
                $"api/equipos/{EquipoId}/temperatura-actual", cancelacion.Token);
            error = null;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    // La alerta tiene prioridad visual sobre cualquier otro estado.
    private string ClaseEstado => datos switch
    {
        { AlertaActiva: not null } => "estado-alerta",
        { Estado: EstadoLectura.Actualizada } => "estado-actualizada",
        { Estado: EstadoLectura.Desactualizada } => "estado-desactualizada",
        _ => "estado-sindatos"
    };

    private string TextoEstado => datos switch
    {
        { AlertaActiva.Tipo: TipoAlertaDto.TemperaturaAlta } => "Fuera de rango: temperatura alta",
        { AlertaActiva.Tipo: TipoAlertaDto.TemperaturaBaja } => "Fuera de rango: temperatura baja",
        { Estado: EstadoLectura.Actualizada } => "Lectura actualizada",
        { Estado: EstadoLectura.Desactualizada } => "Lectura desactualizada: no llegan datos del dispositivo",
        _ => "Sin datos"
    };

    public void Dispose()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}
