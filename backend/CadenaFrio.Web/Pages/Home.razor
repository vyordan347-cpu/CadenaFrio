@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using System.Net.Http.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Utilidades
@inject HttpClient Http
@implements IDisposable

<PageTitle>Cadena de frío - Temperatura actual</PageTitle>

<main class="contenedor">
    @if (error is not null)
    {
        <div class="tarjeta estado-error">
            <p class="equipo">No se pudo obtener la temperatura</p>
            <p class="detalle">Revise que el servidor esté en funcionamiento. Se reintentará en unos segundos.</p>
        </div>
    }
    else if (datos is null)
    {
        <p class="cargando">Cargando…</p>
    }
    else
    {
        <div class="tarjeta @ClaseEstado">
            <p class="equipo">@datos.NombreEquipo</p>

            @if (datos.Estado == EstadoLectura.SinDatos)
            {
                <p class="temperatura">-- °C</p>
                <p class="estado">Sin datos</p>
                <p class="detalle">Este equipo todavía no ha enviado lecturas.</p>
            }
            else
            {
                <p class="temperatura">@datos.Temperatura?.ToString("0.0") °C</p>
                <p class="estado">@TextoEstado</p>

                @if (datos.SinSenalDesde is { } sinSenalDesde)
                {
                    @* Aviso de silencio (HU04, HU05). Se muestra junto a cualquier alerta de temperatura. *@
                    <div class="aviso-senal">
                        <p><strong>Sin señal del dispositivo</strong> desde @FormatoFecha.HoraPeru(sinSenalDesde)
                            (@FormatoFecha.Antiguedad(sinSenalDesde))</p>
                        <p>Posible corte de energía o falla de conexión. La temperatura mostrada es la última conocida.</p>
                    </div>
                }

                @if (datos.AlertaActiva is { } alerta)
                {
                    @* Detalle de la alerta activa (HU03). *@
                    <div class="alerta-detalle">
                        <p>
                            Alerta desde @FormatoFecha.HoraPeru(alerta.Inicio)
                            (@FormatoFecha.Antiguedad(alerta.Inicio))
                        </p>
                        @if (alerta.FechaRuptura is { } fechaRuptura && fechaRuptura > alerta.Inicio)
                        {
                            @* Margen que tuvo el personal entre la advertencia y la ruptura. *@
                            <p>
                                Ruptura desde @FormatoFecha.HoraPeru(fechaRuptura),
                                @((int)(fechaRuptura - alerta.Inicio).TotalMinutes) min después de la advertencia
                            </p>
                        }
                        <p>
                            @(alerta.Tipo == TipoAlertaDto.TemperaturaAlta ? "Máxima" : "Mínima") registrada:
                            @alerta.ValorExtremo.ToString("0.0") °C
                        </p>
                    </div>
                }

                <p class="detalle">
                    Última lectura: @FormatoFecha.HoraPeru(datos.FechaMedicion!.Value)
                    (@FormatoFecha.Antiguedad(datos.FechaMedicion.Value))
                </p>
            }

            <p class="rango">
                Óptimo: @datos.OptimoMinimo.ToString("0.0") a @datos.OptimoMaximo.ToString("0.0") °C
                · Límite: @datos.LimiteMinimo.ToString("0.0") a @datos.LimiteMaximo.ToString("0.0") °C
            </p>
        </div>
    }

    @* Rupturas pendientes de revisión (RF08). No desaparecen solas aunque la
       temperatura ya se haya normalizado: alguien debe revisarlas y registrar qué hizo. *@
    @foreach (var pendiente in pendientes)
    {
        <section class="pendiente">
            <p class="pendiente-titulo">
                @(pendiente.Tipo == TipoAlertaDto.SinSenal
                    ? "Silencio prolongado pendiente de revisión"
                    : "Ruptura pendiente de revisión")
            </p>
            <p>
                @if (pendiente.Fin is { } fin)
                {
                    @:@FormatoFecha.HoraPeru(pendiente.Inicio) a @FormatoFecha.HoraPeru(fin)
                    @:(@((int)(fin - pendiente.Inicio).TotalMinutes) min)
                }
                else
                {
                    @:Desde @FormatoFecha.HoraPeru(pendiente.Inicio) (en curso)
                }
            </p>
            @if (pendiente.Tipo == TipoAlertaDto.SinSenal)
            {
                <p>
                    El dispositivo no envió datos. Última temperatura conocida:
                    <strong>@pendiente.ValorExtremo.ToString("0.0") °C</strong>.
                    Verifique físicamente el estado de las vacunas.
                </p>
            }
            else
            {
                <p>
                    Temperatura @(pendiente.Tipo == TipoAlertaDto.TemperaturaAlta ? "máxima" : "mínima"):
                    <strong>@pendiente.ValorExtremo.ToString("0.0") °C</strong>
                    (límite @pendiente.LimiteMinimo.ToString("0.0") a @pendiente.LimiteMaximo.ToString("0.0") °C)
                </p>
            }

            @if (alertaEnRevision == pendiente.Id)
            {
                <EditForm Model="revision" OnValidSubmit="() => RegistrarRevisionAsync(pendiente.Id)">
                    <DataAnnotationsValidator />
                    <label>
                        Acciones realizadas
                        <InputTextArea @bind-Value="revision.Observacion" rows="3"
                                       placeholder="Ej.: Se trasladaron las vacunas al termo y se informó a la Red de Salud." />
                        <ValidationMessage For="() => revision.Observacion" />
                    </label>
                    <div class="acciones">
                        <button type="submit" disabled="@guardandoRevision">
                            @(guardandoRevision ? "Guardando…" : "Guardar revisión")
                        </button>
                        <button type="button" class="secundario" @onclick="CancelarRevision">Cancelar</button>
                    </div>
                </EditForm>
                @if (errorRevision is not null)
                {
                    <p class="error-revision">@errorRevision</p>
                }
            }
            else
            {
                <button class="registrar" @onclick="() => IniciarRevision(pendiente.Id)">Registrar revisión</button>
            }
        </section>
    }

    <p class="pie">Se actualiza automáticamente cada 10 segundos.</p>
</main>

@code {
    // Por ahora la pantalla muestra el equipo de prueba.
    // En el Sprint 6 (dashboard) se mostrarán todos los equipos.
    private const int EquipoId = 1;

    private static readonly TimeSpan IntervaloActualizacion = TimeSpan.FromSeconds(10);

    private TemperaturaActualDto? datos;
    private List<AlertaPendienteDto> pendientes = new();
    private string? error;

    // Revisión en curso: qué alerta se está atendiendo y lo que escribe el usuario.
    private int? alertaEnRevision;
    private AtenderAlertaRequest revision = new();
    private bool guardandoRevision;
    private string? errorRevision;
    private readonly CancellationTokenSource cancelacion = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();

        // Inicia la actualización periódica sin bloquear la primera carga de la página.
        _ = ActualizarPeriodicamenteAsync();
    }

    private async Task ActualizarPeriodicamenteAsync()
    {
        using var temporizador = new PeriodicTimer(IntervaloActualizacion);
        try
        {
            while (await temporizador.WaitForNextTickAsync(cancelacion.Token))
            {
                await CargarAsync();
                // Pide a Blazor que vuelva a dibujar la pantalla con los datos nuevos.
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // El usuario salió de la página: se detiene la actualización.
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            datos = await Http.GetFromJsonAsync<TemperaturaActualDto>(
                $"api/equipos/{EquipoId}/temperatura-actual", cancelacion.Token);
            pendientes = await Http.GetFromJsonAsync<List<AlertaPendienteDto>>(
                $"api/alertas/pendientes?equipoId={EquipoId}", cancelacion.Token) ?? new();
            error = null;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    // La alerta tiene prioridad visual sobre cualquier otro estado.
    private string ClaseEstado => datos switch
    {
        { AlertaActiva.Nivel: NivelAlertaDto.Ruptura } => "estado-ruptura",
        { AlertaActiva.Nivel: NivelAlertaDto.Advertencia } => "estado-advertencia",
        { SinSenalDesde: not null } => "estado-sinsenal",
        { Estado: EstadoLectura.Actualizada } => "estado-actualizada",
        { Estado: EstadoLectura.Desactualizada } => "estado-desactualizada",
        _ => "estado-sindatos"
    };

    private string TextoEstado => datos switch
    {
        // Los textos siguen lo que indica la normativa para cada nivel.
        { AlertaActiva.Nivel: NivelAlertaDto.Ruptura } =>
            "Ruptura de la cadena de frío: activar el plan de contingencia",
        { AlertaActiva: { Nivel: NivelAlertaDto.Advertencia, Tipo: TipoAlertaDto.TemperaturaAlta } } =>
            "Advertencia: temperatura alta. Revisar el termostato",
        { AlertaActiva: { Nivel: NivelAlertaDto.Advertencia, Tipo: TipoAlertaDto.TemperaturaBaja } } =>
            "Advertencia: temperatura baja. Revisar el termostato",
        { SinSenalDesde: not null } => "Última temperatura conocida",
        { Estado: EstadoLectura.Actualizada } => "Lectura actualizada",
        { Estado: EstadoLectura.Desactualizada } => "Lectura desactualizada: no llegan datos del dispositivo",
        _ => "Sin datos"
    };

    private void IniciarRevision(int alertaId)
    {
        alertaEnRevision = alertaId;
        revision = new AtenderAlertaRequest();
        errorRevision = null;
    }

    private void CancelarRevision()
    {
        alertaEnRevision = null;
        errorRevision = null;
    }

    private async Task RegistrarRevisionAsync(int alertaId)
    {
        guardandoRevision = true;
        errorRevision = null;

        try
        {
            var respuesta = await Http.PostAsJsonAsync($"api/alertas/{alertaId}/atender", revision);

            if (respuesta.IsSuccessStatusCode)
            {
                alertaEnRevision = null;
                await CargarAsync();
            }
            else
            {
                errorRevision = "No se pudo registrar la revisión. Intente nuevamente.";
            }
        }
        catch (Exception)
        {
            errorRevision = "No se pudo conectar con el servidor.";
        }
        finally
        {
            guardandoRevision = false;
        }
    }

    public void Dispose()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}
