@page "/equipos/{EquipoId:int}"
@using System.Net.Http.Json
@using System.Text.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Componentes
@using CadenaFrio.Web.Utilidades
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject HttpClient Http
@implements IDisposable

<PageTitle>@(datos?.NombreEquipo ?? "Equipo") · Cadena de Frío</PageTitle>

<main class="pagina">
    <a class="volver" href=""><Icono Nombre="arriba" Tamano="16" Clase="volver-icono" /> Volver al centro de monitoreo</a>

    @* Sin conexión: se avisa, pero se siguen mostrando los últimos datos recibidos. *@
    @if (error is not null)
    {
        <p class="aviso aviso-error aviso-con-icono aviso-superior" role="alert">
            <Icono Nombre="sin-senal" Tamano="18" />
            <span>Sin conexión con el servidor. Se reintentará en unos segundos@(datos is null ? "." : "; los datos pueden no estar al día.")</span>
        </p>
    }

    @if (datos is null)
    {
        @if (error is null)
        {
            <div class="tarjeta panel esqueleto-panel" aria-hidden="true">
                <span class="esqueleto" style="width: 40%; height: 1.6rem"></span>
                <span class="esqueleto" style="height: 16rem"></span>
            </div>
            <p class="solo-lector" role="status">Cargando el equipo…</p>
        }
    }
    else
    {
        <header class="encabezado">
            <span class="equipo-icono"><Icono Nombre="@(datos.TipoEquipo == TipoEquipoDto.Termo ? "termo" : "refrigeradora")" Tamano="26" /></span>
            <div class="encabezado-texto">
                <h1>@datos.NombreEquipo</h1>
                <p class="subtitulo">
                    @(datos.TipoEquipo == TipoEquipoDto.Termo ? "Termo portavacunas" : "Refrigeradora")@(string.IsNullOrWhiteSpace(datos.Ubicacion) ? "" : $" · {datos.Ubicacion}")
                </p>
                @* Estado térmico y comunicación, por separado y siempre con texto. *@
                <div class="insignias">
                    <span class="insignia insignia-@Termico.Clase @(Antigua ? "insignia-antigua" : "")"
                          title="@(Antigua ? "Estado térmico de la última lectura conocida" : "Estado térmico")">
                        <Icono Nombre="@Termico.Icono" Tamano="14" /> @Termico.Texto
                        @if (EstadoEquipo.Antiguedad(datos!) is { } hace)
                        {
                            <span class="insignia-cuando">· @hace</span>
                        }
                    </span>
                    <span class="insignia insignia-@Comunicacion.Clase" title="Comunicación con el dispositivo">
                        <Icono Nombre="@Comunicacion.Icono" Tamano="14" /> @Comunicacion.Texto
                    </span>
                </div>
            </div>
            <div class="acciones-pagina">
                <a class="boton" href="historial?equipo=@EquipoId"><Icono Nombre="grafico" Tamano="18" /> Ver historial</a>
                <AuthorizeView Policy="@Politicas.PuedeConfigurarRangos">
                    <a class="boton" href="configuracion?equipo=@EquipoId"><Icono Nombre="configuracion" Tamano="18" /> Configurar rango</a>
                </AuthorizeView>
            </div>
        </header>
    }

    @* La temperatura, a todo lo ancho: es lo principal. Debajo, las alertas por revisar. *@
    <div class="detalle">
    @if (datos is not null)
    {
        var vista = Vista;

        <section class="tarjeta panel @(Antigua ? "antigua" : "")" aria-live="polite" aria-label="Temperatura del equipo">
            <div class="lectura">
                @* Con la lectura antigua, el medidor se atenúa y no pulsa: no es una medición en vivo. *@
                <div class="medidor">
                    <IndicadorTemperatura Temperatura="datos.Temperatura"
                                          OptimoMinimo="datos.OptimoMinimo" OptimoMaximo="datos.OptimoMaximo"
                                          LimiteMinimo="datos.LimiteMinimo" LimiteMaximo="datos.LimiteMaximo"
                                          Estado="@vista.Clase" TextoEstado="@vista.Estado"
                                          Historial="historial" />
                    @if (Antigua && datos.Temperatura is not null)
                    {
                        <span class="sello-antiguo"><Icono Nombre="reloj" Tamano="14" /> Última temperatura conocida</span>
                    }
                </div>

                @* Estado en palabras grandes, cuándo se midió y las cifras de referencia. *@
                <div class="resumen">
                    @* Con la lectura antigua, el estado se atenúa y se aclara que es el último conocido. *@
                    <div>
                        <p class="estado-grande estado-@Termico.Clase @(Antigua ? "estado-antiguo" : "")">
                            <Icono Nombre="@Termico.Icono" Tamano="28" /> @Termico.Texto
                        </p>
                        @if (Antigua)
                        {
                            <p class="estado-aclaracion">Último estado conocido, no una medición actual.</p>
                        }
                    </div>
                    <p class="ultima cifras @(Antigua ? "dato-antiguo" : "")">
                        <Icono Nombre="reloj" Tamano="16" />
                        @(datos.FechaMedicion is { } f ? $"Última lectura {FormatoFecha.Antiguedad(f)} · {FormatoFecha.HoraPeru(f)[..16]}" : "Todavía no hay lecturas")
                    </p>
                    <dl class="cifras-clave cifras">
                        <div>
                            <dt>Rango óptimo</dt>
                            <dd>@datos.OptimoMinimo.ToString("0.0") – @datos.OptimoMaximo.ToString("0.0") °C</dd>
                        </div>
                        <div>
                            <dt>Límite</dt>
                            <dd>@datos.LimiteMinimo.ToString("0.0") – @datos.LimiteMaximo.ToString("0.0") °C</dd>
                        </div>
                        @if (datos.AlertaActiva is { } alerta)
                        {
                            <div class="cifra-alerta">
                                <dt>@(alerta.Tipo == TipoAlertaDto.TemperaturaAlta ? "Máxima" : "Mínima") en esta alerta</dt>
                                <dd>@alerta.ValorExtremo.ToString("0.0") °C</dd>
                            </div>
                        }
                    </dl>
                </div>

                @* Última hora: cómo se movió la temperatura (las lecturas que la página ya trae). *@
                <div class="ultima-hora">
                    <p class="etiqueta"><Icono Nombre="grafico" Tamano="16" /> Última hora</p>
                    @if (historial.Count >= 2)
                    {
                        <div class="tendencia estado-@vista.Clase"><MiniGrafico Valores="historial" /></div>
                        <p class="cifras rango-hora">@historial.Min().ToString("0.0") a @historial.Max().ToString("0.0") °C</p>
                        <p class="nota">@historial.Count lecturas</p>
                    }
                    else
                    {
                        <p class="nota sin-hora">Sin lecturas en la última hora.</p>
                    }
                </div>
            </div>

            @* La acción a tomar, destacada y con el color del estado. *@
            <div class="accion-caja estado-@vista.Clase">
                <Icono Nombre="@(vista.Clase == "ok" ? "info" : vista.Icono)" />
                <span>@vista.Accion</span>
            </div>

            @* "Lo estoy atendiendo": detiene el escalamiento y avisa a los demás. *@
            @if (datos.AlertaUrgente is { } urgente)
            {
                <div class="atencion">
                    @if (urgente.ReconocidaPor is not null)
                    {
                        <p><Icono Nombre="atendiendo" Tamano="18" /> Atendiendo: <b>@urgente.ReconocidaPor</b>
                            (@FormatoFecha.Antiguedad(urgente.FechaReconocimiento!.Value))</p>
                    }
                    else
                    {
                        <p class="sin-atender">Nadie ha confirmado que esté atendiendo esta alerta.</p>
                        <button class="boton boton-primario" disabled="@reconociendo" @onclick="() => ReconocerAsync(urgente.Id)">
                            <Icono Nombre="atendiendo" Tamano="18" /> Lo estoy atendiendo
                        </button>
                    }
                </div>
            }
        </section>
    }

    @* Alertas que exigen revisión (RF08): no desaparecen hasta que alguien las atiende. *@
    <section class="eventos" aria-labelledby="titulo-eventos">
        <header class="eventos-cabecera">
            <span class="eventos-icono"><Icono Nombre="campana" /></span>
            <h2 id="titulo-eventos">Alertas por revisar</h2>
            @if (pendientes.Count > 0)
            {
                <span class="contador">@pendientes.Count</span>
            }
        </header>

        @if (pendientes.Count == 0)
        {
            <p class="sin-pendientes"><Icono Nombre="ok" Tamano="18" /> No hay alertas pendientes de revisión.</p>
        }

        @* Dos columnas en pantallas anchas; la que se está revisando ocupa todo el ancho. *@
        <div class="lista-pendientes">
        @foreach (var pendiente in PendientesVisibles)
        {
            <article class="tarjeta pendiente @(pendiente.Tipo == TipoAlertaDto.SinSenal ? "pendiente-sen" : "") @(alertaEnRevision == pendiente.Id ? "en-revision" : "")">
                <div class="pendiente-fila">
                    <span class="pendiente-icono">
                        <Icono Nombre="@(pendiente.Tipo == TipoAlertaDto.SinSenal ? "sin-senal" : "ruptura")" />
                    </span>
                    <div class="pendiente-texto">
                        <p class="pendiente-titulo">@TituloPendiente(pendiente)</p>
                        <p class="pendiente-linea cifras">
                            <Icono Nombre="calendario" Tamano="16" />
                            Desde @FormatoFecha.HoraPeru(pendiente.Inicio), @DuracionPendiente(pendiente)
                        </p>
                        <p class="pendiente-linea cifras">
                            <Icono Nombre="temperatura" Tamano="16" />
                            @ValorPendiente(pendiente)
                        </p>
                        @if (pendiente.FechaLimiteNotificacion is { } limite)
                        {
                            @* Plazo para notificar la ruptura: 24 h (NTS 242, numeral 6.10.2.1). *@
                            var restante = limite - DateTime.UtcNow;
                            <p class="plazo @(restante > TimeSpan.Zero ? "plazo-vigente" : "plazo-vencido")">
                                <Icono Nombre="reloj" Tamano="16" />
                                @(restante > TimeSpan.Zero
                                    ? $"Quedan {FormatoFecha.Duracion(restante)} para notificar (Anexo 13)."
                                    : $"Plazo de notificación vencido hace {FormatoFecha.Duracion(-restante)}.")
                            </p>
                        }
                        @if (pendiente.FechaDeteccion is { } det && pendiente.FechaRuptura is { } rup && det - rup > TimeSpan.FromMinutes(5))
                        {
                            @* Se conoció tarde (al reconectarse): el plazo de 24 h corre desde que se conoció. *@
                            <p class="etiqueta-tarde">
                                Ocurrió el @FormatoFecha.HoraPeru(rup)[..16]; se conoció el @FormatoFecha.HoraPeru(det)[..16] al sincronizar. El plazo corre desde que se conoció.
                            </p>
                        }
                        else if (pendiente.DetectadaTarde)
                        {
                            <p class="etiqueta-tarde">Detectada al sincronizar</p>
                        }
                    </div>
                    @if (alertaEnRevision != pendiente.Id)
                    {
                        <button class="revisar" @onclick="() => IniciarRevision(pendiente.Id)">
                            <Icono Nombre="ojo" Tamano="18" /> Revisar
                        </button>
                    }
                </div>

                @if (alertaEnRevision == pendiente.Id)
                {
                    <EditForm Model="revision" OnValidSubmit="() => RegistrarRevisionAsync(pendiente.Id)" class="revision">
                        <DataAnnotationsValidator />
                        @if (pendiente.RequiereAnexo13 && catalogo is not null)
                        {
                            @* Notificación de ruptura con las listas del Anexo N° 13 (NTS 242). *@
                            <p class="revision-nota">Datos para el formato de notificación de ruptura (Anexo N° 13).</p>
                            <label>
                                Causa de la ruptura
                                <InputSelect @bind-Value="revision.CausaRuptura">
                                    <option value="">Elija una causa</option>
                                    @foreach (var (grupo, opciones) in AgruparConsecutivas(CausasPara(pendiente)))
                                    {
                                        if (grupo is null)
                                        {
                                            foreach (var opcion in opciones)
                                            {
                                                <option value="@opcion.Codigo">@opcion.Descripcion</option>
                                            }
                                        }
                                        else
                                        {
                                            <optgroup label="@grupo">
                                                @foreach (var opcion in opciones)
                                                {
                                                    <option value="@opcion.Codigo">@opcion.Descripcion</option>
                                                }
                                            </optgroup>
                                        }
                                    }
                                </InputSelect>
                            </label>
                            @if (PideDetalle(CausasPara(pendiente), revision.CausaRuptura))
                            {
                                <label>
                                    Especifique la causa
                                    <InputText @bind-Value="revision.DetalleCausa" maxlength="200" />
                                </label>
                            }
                            <label>
                                ¿Cómo se restableció la cadena de frío?
                                <InputSelect @bind-Value="revision.FormaRestablecimiento">
                                    <option value="">Elija una opción</option>
                                    @foreach (var opcion in catalogo.FormasRestablecimiento)
                                    {
                                        <option value="@opcion.Codigo">@opcion.Descripcion</option>
                                    }
                                </InputSelect>
                            </label>
                            @if (PideDetalle(catalogo.FormasRestablecimiento, revision.FormaRestablecimiento))
                            {
                                <label>
                                    Especifique cómo
                                    <InputText @bind-Value="revision.DetalleRestablecimiento" maxlength="200" />
                                </label>
                            }
                            <fieldset class="si-no">
                                <legend>¿Las vacunas están inmovilizadas?</legend>
                                <label>
                                    <input type="radio" name="inmovilizadas-@pendiente.Id"
                                           checked="@(revision.VacunasInmovilizadas == true)"
                                           @onchange="() => revision.VacunasInmovilizadas = true" /> Sí
                                </label>
                                <label>
                                    <input type="radio" name="inmovilizadas-@pendiente.Id"
                                           checked="@(revision.VacunasInmovilizadas == false)"
                                           @onchange="() => revision.VacunasInmovilizadas = false" /> No
                                </label>
                            </fieldset>
                            <label>
                                Comentarios (opcional)
                                <InputTextArea @bind-Value="revision.Observacion" rows="2" />
                                <ValidationMessage For="() => revision.Observacion" />
                            </label>
                        }
                        else
                        {
                            <label>
                                ¿Qué acciones se realizaron?
                                <InputTextArea @bind-Value="revision.Observacion" rows="3"
                                               placeholder="Se verificó la conexión del equipo y se reinició el dispositivo." />
                                <ValidationMessage For="() => revision.Observacion" />
                            </label>
                        }
                        @if (errorRevision is not null)
                        {
                            <p class="aviso aviso-error">@errorRevision</p>
                        }
                        <div class="acciones">
                            <button type="submit" class="boton boton-primario" disabled="@guardandoRevision">
                                @(guardandoRevision ? "Guardando…" : "Guardar revisión")
                            </button>
                            <button type="button" class="boton" @onclick="CancelarRevision">Cancelar</button>
                        </div>
                    </EditForm>
                }
            </article>
        }
        </div>

        @* Si hay muchas, se muestran solo las más recientes para no empujar la tarjeta principal. *@
        @if (pendientes.Count > MaximoVisibles)
        {
            <button class="boton ver-mas" @onclick="() => mostrarTodas = !mostrarTodas">
                <Icono Nombre="@(mostrarTodas ? "arriba" : "abajo")" Tamano="18" />
                @(mostrarTodas ? "Mostrar menos" : $"Ver las otras {pendientes.Count - MaximoVisibles}")
            </button>
        }
    </section>
    </div>

    <p class="pie">Se actualiza cada 10 segundos.</p>
</main>

@code {
    // Equipo a mostrar, tomado de la dirección: /equipos/2
    [Parameter]
    public int EquipoId { get; set; }

    private int equipoCargado;

    private static readonly TimeSpan IntervaloActualizacion = TimeSpan.FromSeconds(10);

    private TemperaturaActualDto? datos;

    // Lecturas de la última hora, para el mini gráfico y la tendencia del indicador.
    private List<double> historial = new();
    private List<AlertaPendienteDto> pendientes = new();
    private string? error;
    private readonly CancellationTokenSource cancelacion = new();

    // Revisión en curso.
    private int? alertaEnRevision;
    private AtenderAlertaRequest revision = new();
    private bool guardandoRevision;
    private string? errorRevision;

    protected override void OnInitialized() => _ = ActualizarPeriodicamenteAsync();

    // Se ejecuta al entrar y cada vez que cambia el equipo de la dirección.
    protected override async Task OnParametersSetAsync()
    {
        if (EquipoId != equipoCargado)
        {
            equipoCargado = EquipoId;
            datos = null;
            historial = new();
            await CargarAsync();
        }
    }

    private async Task ActualizarPeriodicamenteAsync()
    {
        using var temporizador = new PeriodicTimer(IntervaloActualizacion);
        try
        {
            while (await temporizador.WaitForNextTickAsync(cancelacion.Token))
            {
                await CargarAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task CargarAsync()
    {
        try
        {
            datos = await Http.GetFromJsonAsync<TemperaturaActualDto>(
                $"api/equipos/{EquipoId}/temperatura-actual", cancelacion.Token);
            pendientes = await Http.GetFromJsonAsync<List<AlertaPendienteDto>>(
                $"api/alertas/pendientes?equipoId={EquipoId}", cancelacion.Token) ?? new();
            var recientes = await Http.GetFromJsonAsync<List<LecturaPuntoDto>>(
                $"api/equipos/{EquipoId}/lecturas-recientes?minutos=60", cancelacion.Token);
            historial = recientes?.Select(l => l.Temperatura).ToList() ?? new();
            error = null;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    // ---------- Qué mostrar según el estado ----------

    // El estado visible se calcula en un solo lugar, compartido con el panel.
    private VistaEstado Vista => EstadoEquipo.Calcular(datos!);

    // Estado térmico y comunicación por separado (las mismas reglas que el panel).
    private Dimension Termico => EstadoEquipo.Termico(datos!);
    private Dimension Comunicacion => EstadoEquipo.Comunicacion(datos!);
    private bool Antigua => EstadoEquipo.LecturaAntigua(datos!);

    // ---------- Pendientes de revisión ----------

    private const int MaximoVisibles = 4;
    private bool mostrarTodas;

    // Las más recientes primero.
    private IEnumerable<AlertaPendienteDto> PendientesVisibles =>
        mostrarTodas
            ? pendientes.OrderByDescending(p => p.Inicio)
            : pendientes.OrderByDescending(p => p.Inicio).Take(MaximoVisibles);

    private static string TituloPendiente(AlertaPendienteDto p) =>
        p.Tipo == TipoAlertaDto.SinSenal ? "Silencio prolongado por revisar" : "Ruptura por revisar";

    private static string DuracionPendiente(AlertaPendienteDto p) =>
        p.Fin is { } fin ? $"duró {FormatoFecha.Duracion(fin - p.Inicio)}." : "en curso.";

    private static string ValorPendiente(AlertaPendienteDto p) => p.Tipo switch
    {
        TipoAlertaDto.SinSenal => $"Última temperatura conocida: {p.ValorExtremo:0.0} °C.",
        TipoAlertaDto.TemperaturaAlta => $"Máxima: {p.ValorExtremo:0.0} °C (límite {p.LimiteMaximo:0.0} °C).",
        _ => $"Mínima: {p.ValorExtremo:0.0} °C (límite {p.LimiteMinimo:0.0} °C)."
    };

    // Listas del Anexo 13. Se piden una sola vez, al abrir la primera revisión.
    private CatalogoAnexo13Dto? catalogo;

    private async Task IniciarRevision(int alertaId)
    {
        alertaEnRevision = alertaId;
        revision = new AtenderAlertaRequest();
        errorRevision = null;

        if (catalogo is null)
        {
            try
            {
                catalogo = await Http.GetFromJsonAsync<CatalogoAnexo13Dto>("api/alertas/catalogo-anexo13");
            }
            catch (Exception)
            {
                errorRevision = "No se pudieron cargar las listas del Anexo 13.";
            }
        }
    }

    // El formato tiene una lista de causas para refrigeradoras y otra para termos.
    private List<OpcionAnexo13Dto> CausasPara(AlertaPendienteDto p) =>
        p.TipoEquipo == TipoEquipoDto.Termo ? catalogo!.CausasTermo : catalogo!.CausasRefrigerador;

    // Junta las opciones seguidas que comparten encabezado (por ejemplo, las de falla de energía)
    // sin cambiar el orden del formato.
    private static List<(string? Grupo, List<OpcionAnexo13Dto> Opciones)> AgruparConsecutivas(List<OpcionAnexo13Dto> opciones)
    {
        var grupos = new List<(string? Grupo, List<OpcionAnexo13Dto> Opciones)>();
        foreach (var opcion in opciones)
        {
            if (grupos.Count > 0 && grupos[^1].Grupo == opcion.Grupo)
            {
                grupos[^1].Opciones.Add(opcion);
            }
            else
            {
                grupos.Add((opcion.Grupo, new List<OpcionAnexo13Dto> { opcion }));
            }
        }
        return grupos;
    }

    // "Otro" y "Otra causa" muestran un campo para escribir cuál fue.
    private static bool PideDetalle(List<OpcionAnexo13Dto> opciones, string? codigo) =>
        opciones.Any(o => o.Codigo == codigo && o.RequiereDetalle);

    private void CancelarRevision()
    {
        alertaEnRevision = null;
        errorRevision = null;
    }

    private async Task RegistrarRevisionAsync(int alertaId)
    {
        guardandoRevision = true;
        errorRevision = null;

        try
        {
            var respuesta = await Http.PostAsJsonAsync($"api/alertas/{alertaId}/atender", revision);

            if (respuesta.IsSuccessStatusCode)
            {
                alertaEnRevision = null;
                await CargarAsync();
            }
            else
            {
                errorRevision = await LeerErrorAsync(respuesta);
            }
        }
        catch (Exception)
        {
            errorRevision = "No se pudo conectar con el servidor.";
        }
        finally
        {
            guardandoRevision = false;
        }
    }

    // La API explica qué falta en { "mensaje": "..." }; si no, un mensaje general.
    private static async Task<string> LeerErrorAsync(HttpResponseMessage respuesta)
    {
        try
        {
            using var documento = JsonDocument.Parse(await respuesta.Content.ReadAsStringAsync());
            if (documento.RootElement.TryGetProperty("mensaje", out var mensaje))
            {
                return mensaje.GetString() ?? "No se pudo registrar la revisión.";
            }
        }
        catch (JsonException)
        {
        }

        return "No se pudo registrar la revisión. Intente nuevamente.";
    }

    private bool reconociendo;

    private async Task ReconocerAsync(int alertaId)
    {
        reconociendo = true;
        await Http.PostAsync($"api/alertas/{alertaId}/reconocer", null);
        await CargarAsync();
        reconociendo = false;
    }

    public void Dispose()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}
