@page "/admin/equipos"
@using System.Net.Http.Json
@using System.Text.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Componentes
@using CadenaFrio.Web.Utilidades
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = Politicas.EsAdministrador)]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Equipos · Administración · Cadena de Frío</PageTitle>

<main class="pagina">

    <header class="encabezado">
        <span class="encabezado-icono"><Icono Nombre="admin" Tamano="26" /></span>
        <div class="encabezado-texto">
            <h1>Equipos</h1>
            <p class="subtitulo">Refrigeradoras y termos monitoreados, y las claves de sus dispositivos.</p>
        </div>
        @if (!formularioVisible)
        {
            <button class="boton boton-primario" @onclick="NuevoEquipo">
                <Icono Nombre="agregar" Tamano="18" /> Registrar equipo
            </button>
        }
    </header>

    @* Clave recién generada: se muestra una sola vez. *@
    @if (claveGenerada is not null)
    {
        <section class="tarjeta clave" role="alert">
            <h2><Icono Nombre="clave" /> Clave de "@claveGenerada.Equipo.Nombre"</h2>
            <p>Cópiela ahora en <code>credenciales.h</code> del dispositivo. <strong>No se volverá a mostrar:</strong>
                en la base de datos solo se guarda su huella cifrada.</p>
            <div class="clave-fila">
                @* Al hacer clic en la clave, se selecciona completa para copiarla a mano si hace falta. *@
                <input class="clave-valor" readonly value="@claveGenerada.Clave" onfocus="this.select()" aria-label="Clave generada" />
                <button class="boton" @onclick="CopiarClaveAsync">
                    <Icono Nombre="@(claveCopiada ? "check" : "copiar")" Tamano="18" /> @(claveCopiada ? "Copiada" : "Copiar")
                </button>
            </div>
            @if (errorCopia)
            {
                <p class="nota">No se pudo copiar automáticamente. Seleccione la clave y use Ctrl + C.</p>
            }
            <button class="boton" @onclick="CerrarClave">Ya la guardé</button>
        </section>
    }

    @* Formulario para registrar o editar. *@
    @if (formularioVisible)
    {
        <section class="tarjeta formulario">
            <h2><Icono Nombre="@(equipoEnEdicion is null ? "agregar" : "editar")" />
                @(equipoEnEdicion is null ? "Registrar equipo" : $"Editar \"{equipoEnEdicion.Nombre}\"")</h2>

            <EditForm Model="solicitud" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <div class="campos">
                    <label>
                        Nombre
                        <InputText @bind-Value="solicitud.Nombre" placeholder="Refrigeradora principal" />
                        <ValidationMessage For="() => solicitud.Nombre" />
                    </label>
                    <label>
                        Tipo
                        <InputSelect @bind-Value="solicitud.Tipo">
                            <option value="">Elija una opción</option>
                            <option value="@TipoEquipoDto.Refrigeradora">Refrigeradora</option>
                            <option value="@TipoEquipoDto.Termo">Termo portavacunas</option>
                        </InputSelect>
                        <ValidationMessage For="() => solicitud.Tipo" />
                    </label>
                    <label class="campo-ancho">
                        Ubicación
                        <InputText @bind-Value="solicitud.Ubicacion" placeholder="Sala de inmunizaciones" />
                        <ValidationMessage For="() => solicitud.Ubicacion" />
                    </label>
                </div>

                @if (errorFormulario is not null)
                {
                    <p class="aviso aviso-error">@errorFormulario</p>
                }

                <div class="acciones">
                    <button type="submit" class="boton boton-primario" disabled="@guardando">
                        @(guardando ? "Guardando…" : equipoEnEdicion is null ? "Registrar y generar clave" : "Guardar cambios")
                    </button>
                    <button type="button" class="boton" @onclick="CerrarFormulario">Cancelar</button>
                </div>
            </EditForm>
        </section>
    }

    @if (errorCarga is not null)
    {
        <p class="aviso aviso-error aviso-con-icono"><Icono Nombre="sin-senal" Tamano="18" /> @errorCarga</p>
    }
    else if (equipos is null)
    {
        <div class="tarjeta tabla-tarjeta" aria-hidden="true">
            @for (var i = 0; i < 3; i++)
            {
                <span class="esqueleto fila-esqueleto"></span>
            }
        </div>
        <p class="solo-lector" role="status">Cargando equipos…</p>
    }
    else if (equipos.Count == 0)
    {
        <div class="tarjeta estado-vacio">
            <Icono Nombre="refrigeradora" Tamano="36" />
            <h2>Todavía no hay equipos</h2>
            <p>Registre la primera refrigeradora o termo para empezar a recibir lecturas.</p>
        </div>
    }
    else
    {
        <section class="tarjeta tabla-tarjeta" aria-labelledby="titulo-lista">
            <h2 id="titulo-lista" class="solo-lector">Equipos registrados</h2>
            <div class="tabla-contenedor">
                <table class="tabla tabla-equipos">
                    <thead>
                        <tr>
                            <th scope="col">Equipo</th>
                            <th scope="col">Ubicación</th>
                            <th scope="col">Habilitación</th>
                            <th scope="col">Conexión</th>
                            <th scope="col">Temperatura</th>
                            <th scope="col"><span class="solo-lector">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var equipo in equipos)
                        {
                            <tr class="@(equipo.Activo ? "" : "inactivo")">
                                <td data-titulo="Equipo">
                                    <div class="equipo-celda">
                                        <span class="equipo-icono">
                                            <Icono Nombre="@(equipo.Tipo == TipoEquipoDto.Termo ? "termo" : "refrigeradora")" Tamano="20" />
                                        </span>
                                        <span class="equipo-texto">
                                            @if (equipo.Activo)
                                            {
                                                <a class="equipo-nombre" href="equipos/@equipo.Id">@equipo.Nombre</a>
                                            }
                                            else
                                            {
                                                <span class="equipo-nombre">@equipo.Nombre</span>
                                            }
                                            <span class="equipo-tipo">@(equipo.Tipo == TipoEquipoDto.Termo ? "Termo portavacunas" : "Refrigeradora")</span>
                                        </span>
                                    </div>
                                </td>
                                <td data-titulo="Ubicación">@(string.IsNullOrWhiteSpace(equipo.Ubicacion) ? "—" : equipo.Ubicacion)</td>
                                @* Tres estados distintos: habilitado no significa que se esté comunicando,
                                   y comunicarse no significa que la temperatura esté bien. *@
                                <td data-titulo="Habilitación">
                                    <span class="insignia insignia-neutra" title="Decisión administrativa: si el sistema acepta lecturas de este equipo">
                                        <Icono Nombre="@(equipo.Activo ? "ok" : "apagar")" Tamano="14" /> @(equipo.Activo ? "Habilitado" : "Deshabilitado")
                                    </span>
                                </td>
                                @{ var estado = equipo.Activo && estados is not null ? estados.GetValueOrDefault(equipo.Id) : null; }
                                <td data-titulo="Conexión">
                                    <div class="estado-celda">
                                        @if (estado is not null)
                                        {
                                            var conexion = EstadoEquipo.Comunicacion(estado);
                                            <span class="insignia insignia-@conexion.Clase">
                                                <Icono Nombre="@conexion.Icono" Tamano="14" /> @conexion.Texto
                                            </span>
                                        }
                                        else if (equipo.Activo)
                                        {
                                            <span class="dato-secundario">No disponible</span>
                                        }
                                        <span class="dato-secundario cifras">
                                            @if (equipo.UltimaSenal is { } s)
                                            {
                                                @($"Última señal {FormatoFecha.Antiguedad(s)} · {FormatoFecha.HoraPeru(s)[..16]}")
                                            }
                                            else
                                            {
                                                @("Nunca ha enviado datos")
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td data-titulo="Temperatura">
                                    <div class="estado-celda">
                                        @if (!equipo.Activo)
                                        {
                                            <span class="dato-secundario">No se monitorea</span>
                                        }
                                        else if (estado is null)
                                        {
                                            <span class="dato-secundario">No disponible</span>
                                        }
                                        else
                                        {
                                            var termico = EstadoEquipo.Termico(estado);
                                            var hace = EstadoEquipo.Antiguedad(estado);
                                            <span class="insignia insignia-@termico.Clase @(hace is null ? "" : "insignia-antigua")">
                                                <Icono Nombre="@termico.Icono" Tamano="14" /> @termico.Texto
                                            </span>
                                            @if (estado.Temperatura is { } t)
                                            {
                                                <span class="dato-secundario cifras">
                                                    @(hace is null ? $"{t:0.0} °C ahora" : $"{t:0.0} °C, última conocida ({hace})")
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td class="celda-acciones">
                                    @* Editar es la acción habitual; las otras dos cambian el funcionamiento
                                       del dispositivo y piden confirmación. *@
                                    <div class="equipo-acciones">
                                        <button class="boton boton-chico" @onclick="() => EditarEquipo(equipo)">
                                            <Icono Nombre="editar" Tamano="16" /> Editar
                                        </button>
                                        <button class="boton boton-chico boton-peligro" @onclick="() => RegenerarClaveAsync(equipo)"
                                                title="La clave actual deja de funcionar al instante">
                                            <Icono Nombre="regenerar" Tamano="16" /> Nueva clave
                                        </button>
                                        <button class="boton boton-chico @(equipo.Activo ? "boton-peligro" : "")" @onclick="() => CambiarEstadoAsync(equipo)">
                                            <Icono Nombre="apagar" Tamano="16" /> @(equipo.Activo ? "Desactivar" : "Activar")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <DialogoConfirmacion @ref="dialogo" />
</main>

@code {
    // Confirmación de acciones sensibles (nueva clave, desactivar).
    private DialogoConfirmacion? dialogo;

    private List<EquipoAdminDto>? equipos;
    private string? errorCarga;

    // Estado en vivo de los equipos habilitados (la misma consulta del panel), por id.
    // Nulo si no se pudo cargar: la tabla se muestra igual y esas columnas dicen "No disponible".
    private Dictionary<int, TemperaturaActualDto>? estados;

    // Formulario
    private bool formularioVisible;
    private EquipoAdminDto? equipoEnEdicion;
    private GuardarEquipoRequest solicitud = new();
    private bool guardando;
    private string? errorFormulario;

    // Clave recién generada
    private ClaveGeneradaDto? claveGenerada;
    private bool claveCopiada;
    private bool errorCopia;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            equipos = await Http.GetFromJsonAsync<List<EquipoAdminDto>>("api/admin/equipos");
            errorCarga = null;
        }
        catch (Exception)
        {
            errorCarga = "No se pudo cargar la lista de equipos. Revise que el servidor esté encendido.";
        }

        // Aparte: si falla, la administración de equipos sigue funcionando.
        try
        {
            var lista = await Http.GetFromJsonAsync<List<TemperaturaActualDto>>("api/equipos/estado");
            estados = lista?.ToDictionary(e => e.EquipoId);
        }
        catch (Exception)
        {
            estados = null;
        }
    }

    private void NuevoEquipo()
    {
        equipoEnEdicion = null;
        solicitud = new GuardarEquipoRequest();
        errorFormulario = null;
        formularioVisible = true;
    }

    private void EditarEquipo(EquipoAdminDto equipo)
    {
        equipoEnEdicion = equipo;
        solicitud = new GuardarEquipoRequest { Nombre = equipo.Nombre, Tipo = equipo.Tipo, Ubicacion = equipo.Ubicacion };
        errorFormulario = null;
        formularioVisible = true;
    }

    private void CerrarFormulario()
    {
        formularioVisible = false;
        equipoEnEdicion = null;
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        errorFormulario = null;

        try
        {
            if (equipoEnEdicion is null)
            {
                var respuesta = await Http.PostAsJsonAsync("api/admin/equipos", solicitud);
                if (!respuesta.IsSuccessStatusCode)
                {
                    errorFormulario = await LeerErrorAsync(respuesta);
                    return;
                }
                MostrarClave(await respuesta.Content.ReadFromJsonAsync<ClaveGeneradaDto>());
            }
            else
            {
                var respuesta = await Http.PutAsJsonAsync($"api/admin/equipos/{equipoEnEdicion.Id}", solicitud);
                if (!respuesta.IsSuccessStatusCode)
                {
                    errorFormulario = await LeerErrorAsync(respuesta);
                    return;
                }
            }

            CerrarFormulario();
            await CargarAsync();
        }
        catch (Exception)
        {
            errorFormulario = "No se pudo conectar con el servidor.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task RegenerarClaveAsync(EquipoAdminDto equipo)
    {
        var confirmado = await dialogo!.PreguntarAsync($"¿Generar una nueva clave para \"{equipo.Nombre}\"?",
            "La clave actual dejará de funcionar de inmediato y habrá que cargar la nueva en el dispositivo.", "Generar nueva clave");
        if (!confirmado)
        {
            return;
        }

        var respuesta = await Http.PostAsync($"api/admin/equipos/{equipo.Id}/regenerar-clave", null);
        if (respuesta.IsSuccessStatusCode)
        {
            MostrarClave(await respuesta.Content.ReadFromJsonAsync<ClaveGeneradaDto>());
        }
        await CargarAsync();
    }

    private async Task CambiarEstadoAsync(EquipoAdminDto equipo)
    {
        if (equipo.Activo)
        {
            var confirmado = await dialogo!.PreguntarAsync($"¿Desactivar \"{equipo.Nombre}\"?",
                "Dejará de aceptar lecturas y sus alertas abiertas se cerrarán. Su historial se conserva.", "Desactivar equipo");
            if (!confirmado)
            {
                return;
            }
        }

        var accion = equipo.Activo ? "desactivar" : "activar";
        await Http.PostAsync($"api/admin/equipos/{equipo.Id}/{accion}", null);
        await CargarAsync();
    }

    private void MostrarClave(ClaveGeneradaDto? clave)
    {
        claveGenerada = clave;
        claveCopiada = false;
        errorCopia = false;
    }

    private void CerrarClave() => claveGenerada = null;

    private async Task CopiarClaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", claveGenerada!.Clave);
            claveCopiada = true;
            errorCopia = false;
        }
        catch (Exception)
        {
            // El portapapeles solo funciona en localhost o con HTTPS.
            errorCopia = true;
        }
    }

    private static async Task<string> LeerErrorAsync(HttpResponseMessage respuesta)
    {
        try
        {
            using var documento = JsonDocument.Parse(await respuesta.Content.ReadAsStringAsync());
            if (documento.RootElement.TryGetProperty("mensaje", out var mensaje))
            {
                return mensaje.GetString() ?? "No se pudo guardar.";
            }
        }
        catch (JsonException)
        {
        }

        return "No se pudo guardar. Revise los datos.";
    }
}
