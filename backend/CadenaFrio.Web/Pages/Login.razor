@page "/login"
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Autenticacion
@using CadenaFrio.Web.Componentes
@inject ProveedorEstadoAutenticacion Autenticacion
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesión · Cadena de Frío</PageTitle>

<div class="contenedor">
    <div class="tarjeta acceso">
        <span class="logo"><Icono Nombre="copo" Tamano="34" /></span>
        <h1>Cadena de Frío</h1>
        <p class="subtitulo">Monitoreo de vacunas. Ingrese con su usuario.</p>

        <EditForm Model="solicitud" OnValidSubmit="IngresarAsync">
            <DataAnnotationsValidator />

            <label>
                Usuario
                <InputText @bind-Value="solicitud.NombreUsuario" autocomplete="username" />
                <ValidationMessage For="() => solicitud.NombreUsuario" />
            </label>

            <label>
                Contraseña
                <InputText type="password" @bind-Value="solicitud.Contrasena" autocomplete="current-password" />
                <ValidationMessage For="() => solicitud.Contrasena" />
            </label>

            <button type="submit" class="boton boton-primario" disabled="@ingresando">
                @(ingresando ? "Ingresando…" : "Ingresar")
            </button>
        </EditForm>

        @if (error is not null)
        {
            <p class="aviso aviso-error">@error</p>
        }

        @* Proyecto académico: identificación de la universidad. *@
        <footer class="academico">
            <img src="img/usmp-escudo.png" alt="Escudo de la Universidad de San Martín de Porres" width="44" height="49" />
            <p>Proyecto académico<br /><strong>Universidad de San Martín de Porres</strong></p>
        </footer>
    </div>
</div>

@code {
    // Página a la que el usuario quería ir antes de que se le pidiera iniciar sesión.
    [SupplyParameterFromQuery]
    public string? Volver { get; set; }

    private LoginRequest solicitud = new();
    private bool ingresando;
    private string? error;

    private async Task IngresarAsync()
    {
        ingresando = true;
        error = null;

        error = await Autenticacion.IniciarSesionAsync(solicitud);

        if (error is null)
        {
            Navegacion.NavigateTo(DestinoSeguro());
        }

        ingresando = false;
    }

    // Solo se permite volver a páginas de esta misma app. Si "volver" apuntara
    // a otro sitio (por ejemplo "//sitio-falso.com"), se va al inicio.
    private string DestinoSeguro() =>
        string.IsNullOrWhiteSpace(Volver) || Volver.Contains(':') || Volver.StartsWith('/') || Volver.StartsWith('\\')
            ? string.Empty
            : Volver;
}
