@page "/configuracion"
@using System.Net.Http.Json
@using System.Text.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Shared.Utilidades
@using CadenaFrio.Web.Componentes
@using CadenaFrio.Web.Utilidades
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@* Todos los roles ven los rangos; solo el responsable de inmunizaciones (NTS 242, 5.1.43) y el
   administrador los cambian. La API también lo exige. *@
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navegacion
@inject AuthenticationStateProvider Autenticacion
@inject IAuthorizationService Autorizacion

<PageTitle>Rangos de conservación · Cadena de Frío</PageTitle>

<main class="pagina">
    <header class="encabezado">
        <span class="encabezado-icono"><Icono Nombre="temperatura" Tamano="26" /></span>
        <div class="encabezado-texto">
            <h1>Rangos de conservación</h1>
            <p class="subtitulo">Elija el equipo y las vacunas que guarda: el sistema calcula su rango seguro.</p>
        </div>
        @if (equipos is { Count: > 0 })
        {
            <label class="selector">
                Equipo
                <select value="@equipoId" @onchange="CambiarEquipoAsync">
                    @foreach (var equipo in equipos)
                    {
                        <option value="@equipo.Id">@equipo.Nombre</option>
                    }
                </select>
            </label>
        }
    </header>

    @if (errorCarga is not null)
    {
        <p class="aviso aviso-error">@errorCarga</p>
    }
    else if (vigente is null || catalogo is null)
    {
        <p class="nota">Cargando…</p>
    }
    else
    {
        var calculo = Calculo;

        @* Izquierda: vacunas que guarda el equipo y, debajo, el ajuste manual.
           Derecha: el rango vigente frente al que resulta de las vacunas marcadas. *@
        <div class="configuracion">
        <div class="columna">
        <section class="tarjeta" aria-labelledby="titulo-vacunas">
            <header class="tarjeta-cabecera">
                <h2 id="titulo-vacunas"><Icono Nombre="vacuna" /> Vacunas que guarda</h2>
                <span class="insignia insignia-neutra cifras">@seleccion.Count de @catalogo.Count</span>
            </header>
            @if (puedeConfigurar)
            {
                <p class="nota">Marque las vacunas de este equipo. Puede marcar varias si tienen una temperatura en común; las que no se pueden guardar con las marcadas quedan bloqueadas.</p>
            }
            else
            {
                <p class="aviso aviso-info aviso-con-icono solo-lectura">
                    <Icono Nombre="info" Tamano="18" />
                    <span><strong>Solo lectura.</strong> Los rangos los configura el responsable de inmunizaciones (NTS 242, 5.1.43).</span>
                </p>
            }

                <div class="vacunas">
                    @foreach (var vacuna in catalogo)
                    {
                        var marcada = seleccion.Contains(vacuna.Id);
                        @* Una vacuna no marcada que no se cruza con las marcadas se bloquea y dice por qué.
                           La API vuelve a validar al guardar. *@
                        var motivo = marcada || !puedeConfigurar ? null : CompatibilidadVacunas.Motivo(vacuna, Elegidas);
                        <label class="vacuna-opcion @(marcada ? "marcada" : "") @(motivo is null ? "" : "bloqueada") @(puedeConfigurar ? "" : "lectura")">
                            <input type="checkbox" checked="@marcada" disabled="@(motivo is not null || !puedeConfigurar)"
                                   aria-describedby="@(motivo is null ? null : $"motivo-{vacuna.Id}")"
                                   @onchange="() => Alternar(vacuna.Id)" />
                            <span class="vacuna-texto">
                                <span class="vacuna-nombre">@vacuna.Nombre</span>
                                <span class="vacuna-rango cifras">
                                    Óptimo @vacuna.OptimoMinimo.ToString("0.0")–@vacuna.OptimoMaximo.ToString("0.0") °C,
                                    límite @vacuna.LimiteMinimo.ToString("0.0")–@vacuna.LimiteMaximo.ToString("0.0") °C
                                </span>
                                @if (motivo is not null)
                                {
                                    <span class="vacuna-motivo" id="motivo-@vacuna.Id">
                                        <Icono Nombre="ruptura" Tamano="14" /> <span><b>No compatible.</b> @motivo</span>
                                    </span>
                                }
                            </span>
                        </label>
                    }
                    @if (catalogo.Count == 0)
                    {
                        <p class="nota">El catálogo está vacío. El administrador puede agregar vacunas en Administración.</p>
                    }
                </div>
        </section>

        @* Ajuste avanzado: solo para casos especiales y personal autorizado. Pide motivo y
           confirmación, queda en el historial y en la bitácora, y no puede ampliar el rango de
           las vacunas del equipo ni el de la NTS 242 (la API lo valida). *@
        @if (puedeConfigurar)
        {
            var (referencia, origenReferencia) = ReferenciaAjuste;
            <details class="tarjeta ajuste">
                <summary><Icono Nombre="editar" /> Ajuste avanzado <span class="insignia insignia-neutra">Personal autorizado</span></summary>
                <p class="nota">Solo para casos especiales. Queda en el historial y en la bitácora con su motivo.
                    Si luego cambia las vacunas del equipo, el rango se volverá a calcular.</p>
                <p class="aviso aviso-info aviso-con-icono limite-ajuste">
                    <Icono Nombre="info" Tamano="18" />
                    <span>Puede hacerlo <strong>más estricto, nunca más amplio</strong> que el rango de @origenReferencia:
                        óptimo dentro de <b class="cifras">@referencia.OptimoMin.ToString("0.0")–@referencia.OptimoMax.ToString("0.0") °C</b>
                        y límite dentro de <b class="cifras">@referencia.LimiteMin.ToString("0.0")–@referencia.LimiteMax.ToString("0.0") °C</b>.</span>
                </p>

                <EditForm Model="manual" OnValidSubmit="ConfirmarAjusteAsync">
                    <DataAnnotationsValidator />
                    @* Los rangos se pueden escribir en °F (insertos importados); se guardan en °C. *@
                    <SelectorUnidad @bind-Fahrenheit="enFahrenheit" />

                    <fieldset>
                        <legend>Rango óptimo</legend>
                        <div class="campos">
                            <label>Mínimo (@Unidad)
                                <EntradaTemperatura @bind-Valor="manual.OptimoMinimo" Fahrenheit="enFahrenheit" />
                                <ValidationMessage For="() => manual.OptimoMinimo" />
                            </label>
                            <label>Máximo (@Unidad)
                                <EntradaTemperatura @bind-Valor="manual.OptimoMaximo" Fahrenheit="enFahrenheit" />
                                <ValidationMessage For="() => manual.OptimoMaximo" />
                            </label>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Rango límite</legend>
                        <div class="campos">
                            <label>Mínimo (@Unidad)
                                <EntradaTemperatura @bind-Valor="manual.LimiteMinimo" Fahrenheit="enFahrenheit" />
                                <ValidationMessage For="() => manual.LimiteMinimo" />
                            </label>
                            <label>Máximo (@Unidad)
                                <EntradaTemperatura @bind-Valor="manual.LimiteMaximo" Fahrenheit="enFahrenheit" />
                                <ValidationMessage For="() => manual.LimiteMaximo" />
                            </label>
                        </div>
                    </fieldset>

                    <label>Motivo del ajuste
                        <InputTextArea @bind-Value="manual.Motivo" rows="2" maxlength="250"
                                       placeholder="Por ejemplo: el inserto de la vacuna nueva indica un rango más estricto." />
                        <ValidationMessage For="() => manual.Motivo" />
                    </label>

                    @if (mensajeManual is not null)
                    {
                        <p class="aviso @(errorManual ? "aviso-error" : "aviso-ok")">@mensajeManual</p>
                    }

                    <button type="submit" class="boton" disabled="@guardandoManual">
                        @(guardandoManual ? "Guardando…" : "Revisar y guardar el ajuste")
                    </button>
                </EditForm>
            </details>
        }
        </div>

        @* Rango del equipo: el vigente frente al de las vacunas marcadas, que se recalcula al
           instante con cada casilla (reactividad de Blazor). *@
        <aside class="tarjeta resultado" aria-labelledby="titulo-resultado" aria-live="polite">
            <header class="tarjeta-cabecera">
                <h2 id="titulo-resultado"><Icono Nombre="temperatura" /> Rango del equipo</h2>
                @* Compatibilidad: con ícono y palabra, no solo color. *@
                @if (seleccion.Count == 0)
                {
                    <span class="insignia insignia-neutra"><Icono Nombre="info" Tamano="14" /> Sin vacunas</span>
                }
                else if (calculo is null)
                {
                    <span class="insignia insignia-rup"><Icono Nombre="ruptura" Tamano="14" /> Incompatibles</span>
                }
                else
                {
                    <span class="insignia insignia-ok"><Icono Nombre="ok" Tamano="14" /> Compatibles</span>
                }
            </header>

            <div class="comparacion cifras">
                <div class="lado">
                    <p class="etiqueta">Vigente ahora</p>
                    <dl>
                        <div><dt>Óptimo</dt><dd>@vigente.OptimoMinimo.ToString("0.0") – @vigente.OptimoMaximo.ToString("0.0") °C</dd></div>
                        <div><dt>Límite</dt><dd>@vigente.LimiteMinimo.ToString("0.0") – @vigente.LimiteMaximo.ToString("0.0") °C</dd></div>
                    </dl>
                </div>
                <div class="lado propuesto">
                    <p class="etiqueta">Con las vacunas marcadas</p>
                    @if (seleccion.Count == 0)
                    {
                        <p class="detalle">Marque las vacunas que guarda este equipo para calcular su rango. Sin vacunas, el equipo conserva su rango vigente.</p>
                    }
                    else if (calculo is null)
                    {
                        <p class="detalle">No existe una temperatura segura para todas.</p>
                    }
                    else
                    {
                        <dl>
                            <div><dt>Óptimo</dt><dd>@calculo.Value.OptimoMin.ToString("0.0") – @calculo.Value.OptimoMax.ToString("0.0") °C</dd></div>
                            <div><dt>Límite</dt><dd>@calculo.Value.LimiteMin.ToString("0.0") – @calculo.Value.LimiteMax.ToString("0.0") °C</dd></div>
                        </dl>
                    }
                </div>
            </div>

            @* Origen del rango vigente, a lo ancho para que no alargue la comparación. *@
            <p class="detalle origen-vigente">
                @if (vigente.EsPorDefecto)
                {
                    @:Vigente por defecto: nadie lo ha configurado todavía.
                }
                else
                {
                    @($"Vigente — {vigente.Detalle ?? "Configurado"}, por {vigente.ModificadoPor}, el {FormatoFecha.HoraPeru(vigente.FechaCambio!.Value)}.")
                }
            </p>

            @if (seleccion.Count > 0 && calculo is null)
            {
                <div class="aviso aviso-error aviso-con-icono incompatible" role="alert">
                    <Icono Nombre="ruptura" />
                    <span><strong>Estas vacunas no pueden guardarse juntas.</strong> No hay una temperatura que sirva para todas: quite alguna para continuar. La escala muestra el rango vigente.</span>
                </div>
            }

            @* Escala térmica: la última temperatura juzgada con el rango calculado (o el vigente, si
               no hay un cálculo válido). Sustituye al velocímetro en esta pantalla. *@
            @{
                var rangoEscala = calculo ?? new Rangos(vigente.OptimoMinimo, vigente.OptimoMaximo, vigente.LimiteMinimo, vigente.LimiteMaximo);
                var (estadoEscala, textoEscala) = EstadoVista(rangoEscala);
            }
            <div class="escala-bloque">
                <p class="etiqueta-escala">
                    @(calculo is not null ? "Última temperatura con el rango calculado" : "Última temperatura con el rango vigente")
                </p>
                <EscalaTermica Temperatura="actual?.Temperatura" FechaMedicion="actual?.FechaMedicion"
                               Antigua="@(actual is not null && EstadoEquipo.LecturaAntigua(actual))"
                               OptimoMinimo="rangoEscala.OptimoMin" OptimoMaximo="rangoEscala.OptimoMax"
                               LimiteMinimo="rangoEscala.LimiteMin" LimiteMaximo="rangoEscala.LimiteMax"
                               Estado="@estadoEscala" TextoEstado="@textoEscala"
                               Comunicacion="@(actual is null ? null : EstadoEquipo.Comunicacion(actual))" />
            </div>

            @if (mensajeVacunas is not null)
            {
                <p class="aviso @(errorVacunas ? "aviso-error" : "aviso-ok")">@mensajeVacunas</p>
            }

            @if (puedeConfigurar)
            {
                <div class="acciones">
                    @if (HayCambiosEnVacunas)
                    {
                        <span class="cambios-pendientes"><Icono Nombre="editar" Tamano="14" /> Cambios sin guardar</span>
                    }
                    <button class="boton boton-primario" disabled="@(guardandoVacunas || !HayCambiosEnVacunas || (seleccion.Count > 0 && calculo is null))"
                            @onclick="GuardarVacunasAsync">
                        @(guardandoVacunas ? "Guardando…" : "Guardar vacunas y aplicar rango")
                    </button>
                </div>
            }
        </aside>
        </div>

        @* 4. Historial *@
        <section class="tarjeta">
            <h2><Icono Nombre="reloj" /> Historial de cambios</h2>
            @if (historial.Count == 0)
            {
                <p class="detalle">Aún no se han registrado cambios.</p>
            }
            else
            {
                <div class="tabla-contenedor">
                    <table class="tabla">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Óptimo</th>
                                <th>Límite</th>
                                <th>Origen</th>
                                <th>Registrado por</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cambio in historial)
                            {
                                <tr>
                                    <td>@FormatoFecha.HoraPeru(cambio.FechaCambio!.Value)</td>
                                    <td class="cifras">@cambio.OptimoMinimo.ToString("0.0")–@cambio.OptimoMaximo.ToString("0.0") °C</td>
                                    <td class="cifras">@cambio.LimiteMinimo.ToString("0.0")–@cambio.LimiteMaximo.ToString("0.0") °C</td>
                                    <td class="origen">@(cambio.Detalle ?? "—")</td>
                                    <td>@cambio.ModificadoPor</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>

<DialogoConfirmacion @ref="dialogo" />

@code {
    // Permite abrir la página con un equipo elegido: /configuracion?equipo=2
    [SupplyParameterFromQuery(Name = "equipo")]
    public int? EquipoInicial { get; set; }

    // Unidad en que se escribe el ajuste manual (siempre se guarda en °C).
    private bool enFahrenheit;
    private string Unidad => enFahrenheit ? "°F" : "°C";

    private List<EquipoResumenDto>? equipos;
    private int equipoId;

    private List<VacunaDto>? catalogo;
    private HashSet<int> seleccion = new();
    private HashSet<int> seleccionGuardada = new();
    // Última lectura del equipo (temperatura, fecha, comunicación), para la escala térmica.
    private TemperaturaActualDto? actual;

    private RangoTemperaturaDto? vigente;
    private List<RangoTemperaturaDto> historial = new();
    private ConfigurarRangoRequest manual = new();

    private string? errorCarga;
    private bool guardandoVacunas;
    private string? mensajeVacunas;
    private bool errorVacunas;
    private bool guardandoManual;

    // ¿Este usuario puede cambiar los rangos? (responsable de inmunizaciones o administrador)
    private bool puedeConfigurar;
    private DialogoConfirmacion? dialogo;
    private string? mensajeManual;
    private bool errorManual;

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await Autenticacion.GetAuthenticationStateAsync()).User;
        puedeConfigurar = (await Autorizacion.AuthorizeAsync(usuario, Politicas.PuedeConfigurarRangos)).Succeeded;

        try
        {
            equipos = await Http.GetFromJsonAsync<List<EquipoResumenDto>>("api/equipos/lista") ?? new();
            catalogo = await Http.GetFromJsonAsync<List<VacunaDto>>("api/vacunas") ?? new();

            if (equipos.Count == 0)
            {
                errorCarga = "No hay equipos activos. Regístrelos en Administración.";
                return;
            }

            equipoId = equipos.Any(e => e.Id == EquipoInicial) ? EquipoInicial!.Value : equipos[0].Id;
            await CargarEquipoAsync();
        }
        catch (Exception)
        {
            errorCarga = "No se pudo cargar la configuración. Revise que el servidor esté encendido.";
        }
    }

    private async Task CambiarEquipoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            equipoId = id;
            mensajeVacunas = null;
            mensajeManual = null;
            await CargarEquipoAsync();
        }
    }

    private async Task CargarEquipoAsync()
    {
        var asignadas = await Http.GetFromJsonAsync<List<int>>($"api/equipos/{equipoId}/vacunas") ?? new();
        seleccion = asignadas.ToHashSet();
        seleccionGuardada = asignadas.ToHashSet();

        actual = await Http.GetFromJsonAsync<TemperaturaActualDto>($"api/equipos/{equipoId}/temperatura-actual");

        await CargarRangosAsync();
    }

    private async Task CargarRangosAsync()
    {
        vigente = await Http.GetFromJsonAsync<RangoTemperaturaDto>($"api/equipos/{equipoId}/rango");
        historial = await Http.GetFromJsonAsync<List<RangoTemperaturaDto>>($"api/equipos/{equipoId}/rangos") ?? new();

        manual = new ConfigurarRangoRequest
        {
            OptimoMinimo = vigente?.OptimoMinimo,
            OptimoMaximo = vigente?.OptimoMaximo,
            LimiteMinimo = vigente?.LimiteMinimo,
            LimiteMaximo = vigente?.LimiteMaximo
        };
    }

    // ---------- Vacunas y rango calculado ----------

    private void Alternar(int vacunaId)
    {
        if (!seleccion.Remove(vacunaId))
        {
            // Una vacuna incompatible con las marcadas no se agrega (su casilla ya está bloqueada).
            var vacuna = catalogo!.First(v => v.Id == vacunaId);
            if (CompatibilidadVacunas.Motivo(vacuna, Elegidas) is not null)
            {
                return;
            }
            seleccion.Add(vacunaId);
        }
        mensajeVacunas = null;
    }

    // Vacunas marcadas en este momento (aún sin guardar).
    private List<VacunaDto> Elegidas => catalogo!.Where(v => seleccion.Contains(v.Id)).ToList();

    private bool HayCambiosEnVacunas => !seleccion.SetEquals(seleccionGuardada);

    private record struct Rangos(double OptimoMin, double OptimoMax, double LimiteMin, double LimiteMax);

    // Vista previa del rango común (la intersección). La API vuelve a calcularlo al guardar:
    // el navegador solo muestra, la decisión final es del servidor.
    private Rangos? Calculo
    {
        get
        {
            var elegidas = catalogo!.Where(v => seleccion.Contains(v.Id)).ToList();
            if (elegidas.Count == 0)
            {
                return null;
            }

            var r = new Rangos(
                elegidas.Max(v => v.OptimoMinimo), elegidas.Min(v => v.OptimoMaximo),
                elegidas.Max(v => v.LimiteMinimo), elegidas.Min(v => v.LimiteMaximo));

            return r.OptimoMin < r.OptimoMax ? r : null;
        }
    }

    // Estado que tendría la temperatura actual con el rango calculado.
    private (string Estado, string Texto) EstadoVista(Rangos r) => actual?.Temperatura switch
    {
        null => ("sen", "Sin lecturas"),
        var t when t > r.LimiteMax || t < r.LimiteMin => ("rup", "Ruptura"),
        var t when t > r.OptimoMax || t < r.OptimoMin => ("adv", "Advertencia"),
        _ => ("ok", "Normal")
    };

    private async Task GuardarVacunasAsync()
    {
        guardandoVacunas = true;
        mensajeVacunas = null;
        try
        {
            var respuesta = await Http.PutAsJsonAsync($"api/equipos/{equipoId}/vacunas",
                new AsignarVacunasRequest { VacunaIds = seleccion.ToList() });

            errorVacunas = !respuesta.IsSuccessStatusCode;
            if (errorVacunas)
            {
                mensajeVacunas = await LeerErrorAsync(respuesta);
                return;
            }

            mensajeVacunas = seleccion.Count == 0
                ? "Vacunas guardadas. El equipo conserva su rango actual."
                : "Vacunas guardadas y rango aplicado.";
            seleccionGuardada = seleccion.ToHashSet();
            await CargarRangosAsync();
        }
        catch (Exception)
        {
            errorVacunas = true;
            mensajeVacunas = "No se pudo conectar con el servidor.";
        }
        finally
        {
            guardandoVacunas = false;
        }
    }

    // ---------- Ajuste manual ----------

    // Rango que el ajuste avanzado no puede ampliar: el común de las vacunas guardadas del equipo
    // o, si no guarda ninguna, el de la NTS 242. La misma regla que valida la API.
    private (Rangos Rango, string Origen) ReferenciaAjuste
    {
        get
        {
            var guardadas = catalogo!.Where(v => seleccionGuardada.Contains(v.Id)).ToList();
            if (guardadas.Count > 0)
            {
                var r = new Rangos(
                    guardadas.Max(v => v.OptimoMinimo), guardadas.Min(v => v.OptimoMaximo),
                    guardadas.Max(v => v.LimiteMinimo), guardadas.Min(v => v.LimiteMaximo));
                if (r.OptimoMin < r.OptimoMax)
                {
                    return (r, "las vacunas que guarda");
                }
            }
            return (new Rangos(3.0, 7.0, 2.0, 8.0), "la NTS 242");
        }
    }

    // Antes de guardar, se confirma mostrando el rango vigente, el nuevo y el motivo.
    private async Task ConfirmarAjusteAsync()
    {
        var antes = $"óptimo {vigente!.OptimoMinimo:0.0}–{vigente.OptimoMaximo:0.0} °C, límite {vigente.LimiteMinimo:0.0}–{vigente.LimiteMaximo:0.0} °C";
        var despues = $"óptimo {manual.OptimoMinimo:0.0}–{manual.OptimoMaximo:0.0} °C, límite {manual.LimiteMinimo:0.0}–{manual.LimiteMaximo:0.0} °C";
        var confirmado = await dialogo!.PreguntarAsync(
            "¿Aplicar el ajuste manual del rango?",
            $"Antes: {antes}. Después: {despues}. Motivo: {manual.Motivo?.Trim()}. Las alertas usarán el rango nuevo desde ahora y el cambio queda en la bitácora.",
            "Aplicar ajuste");
        if (confirmado)
        {
            await GuardarManualAsync();
        }
    }

    private async Task GuardarManualAsync()
    {
        guardandoManual = true;
        mensajeManual = null;
        try
        {
            var respuesta = await Http.PostAsJsonAsync($"api/equipos/{equipoId}/rango", manual);
            errorManual = !respuesta.IsSuccessStatusCode;
            mensajeManual = errorManual ? await LeerErrorAsync(respuesta) : "Ajuste manual guardado.";
            if (!errorManual)
            {
                await CargarRangosAsync();
            }
        }
        catch (Exception)
        {
            errorManual = true;
            mensajeManual = "No se pudo conectar con el servidor.";
        }
        finally
        {
            guardandoManual = false;
        }
    }

    private static async Task<string> LeerErrorAsync(HttpResponseMessage respuesta)
    {
        try
        {
            using var documento = JsonDocument.Parse(await respuesta.Content.ReadAsStringAsync());
            var raiz = documento.RootElement;
            if (raiz.TryGetProperty("mensaje", out var mensaje))
            {
                return mensaje.GetString() ?? "No se pudo guardar.";
            }
            if (raiz.TryGetProperty("errors", out var errores))
            {
                foreach (var campo in errores.EnumerateObject())
                {
                    foreach (var detalle in campo.Value.EnumerateArray())
                    {
                        return detalle.GetString() ?? "Revise los datos.";
                    }
                }
            }
        }
        catch (JsonException)
        {
        }

        return "No se pudo guardar. Intente nuevamente.";
    }
}
