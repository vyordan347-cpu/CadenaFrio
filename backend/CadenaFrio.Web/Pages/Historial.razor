@page "/historial"
@using System.Globalization
@using System.Net.Http.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Componentes
@using CadenaFrio.Web.Utilidades
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Historial · Cadena de Frío</PageTitle>

<main class="pagina">
    <header class="encabezado">
        <span class="encabezado-icono"><Icono Nombre="grafico" Tamano="24" /></span>
        <div class="encabezado-texto">
            <h1>Historial</h1>
            <p class="subtitulo">Temperaturas, alertas y revisiones de cada equipo, para revisar incidentes y sustentar reportes.</p>
        </div>
        @if (historial is not null)
        {
            @* El Excel trae el mismo equipo y periodo que se ven en pantalla. *@
            <div class="descargas">
                <a class="boton boton-primario boton-excel" href="@UrlExcel" download>
                    <Icono Nombre="descargar" Tamano="18" /> Exportar a Excel
                </a>

                @* Hoja oficial de control diario (Anexo 10 de la NTS 242) del mes elegido, llenada
                   con las lecturas del sensor: mañana y tarde de cada día. *@
                <div class="anexo10">
                    <label for="mes-anexo10">Hoja del Anexo 10</label>
                    <div class="anexo10-fila">
                        <input id="mes-anexo10" type="month" @bind="mesAnexo10" max="@MesActual" />
                        <a class="boton" href="@UrlAnexo10" download title="Hoja de control y registro diario de la temperatura, llenada con las lecturas del sensor">
                            <Icono Nombre="descargar" Tamano="18" /> Descargar
                        </a>
                    </div>
                </div>
            </div>
        }
    </header>

    @* Filtros: equipo y periodo *@
    <section class="tarjeta filtros" aria-label="Filtros">
        @if (equipos is { Count: > 0 })
        {
            <label class="filtro-equipo">
                Equipo
                <select value="@equipoId" @onchange="CambiarEquipoAsync">
                    @foreach (var equipo in equipos)
                    {
                        <option value="@equipo.Id">@equipo.Nombre</option>
                    }
                </select>
            </label>
        }

        <div class="filtro-periodo">
            <span class="filtro-etiqueta" id="etiqueta-periodo">Periodo</span>
            <div class="periodos" role="group" aria-labelledby="etiqueta-periodo">
                @foreach (var (clave, texto) in Periodos)
                {
                    <button class="periodo @(periodo == clave ? "activo" : "")" aria-pressed="@(periodo == clave ? "true" : "false")"
                            @onclick="() => CambiarPeriodoAsync(clave)">@texto</button>
                }
            </div>
        </div>

        @if (periodo == "personalizado")
        {
            <div class="personalizado">
                <label>Desde <InputDate @bind-Value="diaDesde" /></label>
                <label>Hasta <InputDate @bind-Value="diaHasta" /></label>
                <button class="boton boton-primario" @onclick="CargarAsync">Ver</button>
            </div>
        }
    </section>

    @if (error is not null)
    {
        <p class="aviso aviso-error aviso-con-icono"><Icono Nombre="advertencia" Tamano="18" /> @error</p>
    }
    else if (historial is null)
    {
        <div class="esqueletos" aria-hidden="true">
            @for (var i = 0; i < 4; i++)
            {
                <span class="esqueleto esqueleto-cifra"></span>
            }
            <span class="esqueleto esqueleto-grafico"></span>
        </div>
        <p class="solo-lector" role="status">Cargando el historial…</p>
    }
    else
    {
        var e = historial.Estadisticas;

        @* De qué se trata lo que se ve: equipo, periodo y rangos vigentes. *@
        <p class="resumen-periodo cifras">
            <Icono Nombre="calendario" Tamano="16" />
            <strong>@historial.NombreEquipo</strong>
            <span>· @FormatoFecha.HoraPeru(historial.Desde)[..16] a @FormatoFecha.HoraPeru(historial.Hasta)[..16]</span>
            @if (historial.Rangos.Count > 1)
            {
                <span class="dato-secundario">· el rango cambió en el periodo; al final regía óptimo @historial.OptimoMinimo.ToString("0.#")–@historial.OptimoMaximo.ToString("0.#") °C, límite @historial.LimiteMinimo.ToString("0.#")–@historial.LimiteMaximo.ToString("0.#") °C</span>
            }
            else
            {
                <span class="dato-secundario">· óptimo @historial.OptimoMinimo.ToString("0.#")–@historial.OptimoMaximo.ToString("0.#") °C, límite @historial.LimiteMinimo.ToString("0.#")–@historial.LimiteMaximo.ToString("0.#") °C</span>
            }
        </p>

        @* Resumen en palabras simples y estado de la información: lo primero que se lee.
           Las frases salen de ResumenHistorial (solo hechos, sin conclusiones clínicas). *@
        @if (e.CantidadLecturas > 0)
        {
            var esperadas = ResumenHistorial.LecturasEsperadas(historial);
            var huecos = TramosHistorial.Huecos(historial.Puntos, historial.Desde, historial.Hasta);
            <section class="tarjeta resumen-historial" aria-labelledby="titulo-resumen">
                <h2 id="titulo-resumen">Resumen del periodo</h2>
                <ul class="frases">
                    @foreach (var frase in ResumenHistorial.Frases(historial, huecos))
                    {
                        <li class="frase frase-@frase.Clase">
                            <span class="frase-icono"><Icono Nombre="@frase.Icono" Tamano="20" /></span>
                            <div>
                                <p class="frase-titulo">@frase.Titulo</p>
                                <p class="frase-detalle">@frase.Detalle</p>
                            </div>
                        </li>
                    }
                </ul>

                @* Cuántos datos hay y si están al día. Es un conteo, no un porcentaje de tiempo. *@
                <p class="estado-informacion cifras @(ultimaLecturaAntigua ? "desactualizada" : "")">
                    <Icono Nombre="@(ultimaLecturaAntigua ? "advertencia" : "reloj")" Tamano="16" />
                    <span>
                        Se recibieron @e.CantidadLecturas.ToString("N0", CultureInfo.InvariantCulture) de unas @esperadas.ToString("N0", CultureInfo.InvariantCulture) lecturas esperadas (una por minuto).
                        @if (ultimaLectura is { } u)
                        {
                            @if (ultimaLecturaAntigua)
                            {
                                <strong>Esta información no está al día: la última lectura del equipo es de @FormatoFecha.Antiguedad(u) (@FormatoFecha.HoraPeru(u)[..16]).</strong>
                            }
                            else
                            {
                                <span>Última lectura del equipo: @FormatoFecha.Antiguedad(u).</span>
                            }
                        }
                    </span>
                </p>
            </section>
        }

        @* Qué hacer, justo después de lo que pasó. Se muestra también sin lecturas: es cuando
           más importa revisar el equipo y las alertas pendientes. Los textos están en
           AccionesRecomendadas (para que los valide la persona responsable de inmunizaciones). *@
        var cantidadHuecos = TramosHistorial.Huecos(historial.Puntos, historial.Desde, historial.Hasta).Count;
        var sinDatosAlDia = ultimaLecturaAntigua || e.CantidadLecturas == 0;
            <section class="tarjeta que-hacer" aria-labelledby="titulo-que-hacer">
                <h2 id="titulo-que-hacer">Qué hacer</h2>
                <ol class="acciones-lista">
                    @foreach (var accion in AccionesRecomendadas.Para(historial, cantidadHuecos, sinDatosAlDia))
                    {
                        <li>
                            <span class="accion-icono"><Icono Nombre="@accion.Icono" Tamano="18" /></span>
                            <div>
                                <p>@accion.Texto</p>
                                @if (accion.Enlace is not null)
                                {
                                    <a class="boton boton-chico boton-primario" href="@accion.Enlace">@accion.TextoEnlace</a>
                                }
                            </div>
                        </li>
                    }
                </ol>
            </section>

        @* Cifras clave en palabras cotidianas. Los términos técnicos (cumplimiento térmico,
           promedio) van en la línea de abajo y, más adelante, en la vista detallada. *@
        @if (e.CantidadLecturas > 0)
        {
            var sinRevisar = historial.Alertas.Count(a => a.RequiereRevision && a.AtendidaPor is null);
            <section class="estadisticas" aria-label="Cifras del periodo">
                <div class="tarjeta estadistica">
                    <p class="estadistica-etiqueta"><Icono Nombre="temperatura" Tamano="16" /> Temperatura más baja y más alta</p>
                    <p class="estadistica-valor cifras">@Grados(e.Minima) y @Grados(e.Maxima)</p>
                    <p class="estadistica-texto">
                        @if (e.CantidadFueraDelLimite > 0)
                        {
                            @(e.CantidadFueraDelLimite == 1 ? "1 lectura quedó fuera del límite." : $"{e.CantidadFueraDelLimite:N0} lecturas quedaron fuera del límite.")
                        }
                        else if (historial.Rangos.Count > 1)
                        {
                            @("Ninguna lectura salió del límite de su momento.")
                        }
                        else
                        {
                            @($"El límite permitido es de {historial.LimiteMinimo:0.#} a {historial.LimiteMaximo:0.#} °C.")
                        }
                    </p>
                </div>
                <div class="tarjeta estadistica">
                    <p class="estadistica-etiqueta"><Icono Nombre="ok" Tamano="16" /> Lecturas en el rango recomendado</p>
                    <p class="estadistica-valor cifras">@LecturasEnRango(e)</p>
                    <p class="estadistica-texto">@(historial.Rangos.Count > 1 ? "Cada una con el rango recomendado de su momento." : $"Rango recomendado: {historial.OptimoMinimo:0.#} a {historial.OptimoMaximo:0.#} °C.")</p>
                </div>
                <div class="tarjeta estadistica @(e.CantidadRupturas > 0 ? "alerta" : "")">
                    <p class="estadistica-etiqueta"><Icono Nombre="ruptura" Tamano="16" /> Rupturas de temperatura</p>
                    <p class="estadistica-valor cifras">@(e.CantidadRupturas switch { 0 => "Ninguna", 1 => "1 episodio", var n => $"{n} episodios" })</p>
                    <p class="estadistica-texto">Veces que la temperatura salió del límite permitido.</p>
                </div>
                <div class="tarjeta estadistica @(sinRevisar > 0 ? "alerta" : "")">
                    <p class="estadistica-etiqueta"><Icono Nombre="campana" Tamano="16" /> Alertas sin revisar</p>
                    <p class="estadistica-valor cifras">@(sinRevisar == 0 ? "Ninguna" : sinRevisar.ToString())</p>
                    @if (sinRevisar > 0)
                    {
                        @* La revisión se registra en el detalle del equipo, donde está el formulario. *@
                        <a class="estadistica-accion" href="equipos/@historial.EquipoId">Revisar ahora <Icono Nombre="abajo" Tamano="16" Clase="flecha" /></a>
                    }
                    else
                    {
                        <p class="estadistica-texto">Todas las que lo necesitaban ya se revisaron.</p>
                    }
                </div>
            </section>
        }

        @* Gráfico *@
        <section class="tarjeta seccion" aria-labelledby="titulo-grafico">
            <header class="seccion-cabecera">
                <h2 id="titulo-grafico"><Icono Nombre="grafico" /> Temperatura en el periodo</h2>
            </header>
            @if (e.CantidadLecturas == 0)
            {
                @* Sin lecturas: se dice cuándo fue la última (si la hay) y se ofrece ir a esas fechas.
                   No se inventa nada: la fecha sale de la última lectura guardada del equipo. *@
                <div class="estado-vacio">
                    <Icono Nombre="sin-senal" Tamano="32" />
                    <h3>Sin lecturas en este periodo</h3>
                    @if (ultimaLectura is { } ultima)
                    {
                        var dia = DiaPeru(ultima);
                        <p>
                            La última lectura de este equipo es del <strong class="cifras">@FormatoFecha.HoraPeru(ultima)[..16]</strong>
                            (@FormatoFecha.Antiguedad(ultima)).
                        </p>
                        <div class="acciones-vacio">
                            <button type="button" class="boton boton-primario" @onclick="() => VerDiasAsync(dia, dia)">
                                <Icono Nombre="calendario" Tamano="16" /> Ver el @dia.ToString("dd/MM/yyyy")
                            </button>
                            <button type="button" class="boton" @onclick="() => VerDiasAsync(dia.AddDays(-6), dia)">
                                Ver los 7 días hasta esa fecha
                            </button>
                        </div>
                    }
                    else if (ultimaLecturaConsultada)
                    {
                        <p>Este equipo todavía no ha enviado ninguna lectura.</p>
                    }
                    else
                    {
                        <p>El equipo no envió datos entre esas fechas. Pruebe con un periodo más largo.</p>
                    }
                </div>
            }
            else
            {
                <GraficoHistorial Puntos="historial.Puntos" Alertas="historial.Alertas"
                                  Desde="historial.Desde" Hasta="historial.Hasta"
                                  OptimoMinimo="historial.OptimoMinimo" OptimoMaximo="historial.OptimoMaximo"
                                  LimiteMinimo="historial.LimiteMinimo" LimiteMaximo="historial.LimiteMaximo"
                                  Rangos="historial.Rangos">
                    @* Lo técnico solo aparece en la vista detallada del gráfico. *@
                    <DatosTecnicos>
                        <div><dt>Lecturas recibidas</dt><dd class="cifras">@e.CantidadLecturas.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                        <div><dt>Lecturas fuera del límite</dt><dd class="cifras">@e.CantidadFueraDelLimite.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                        <div><dt>Cambios de rango en el periodo</dt><dd class="cifras">@(historial.Rangos.Count > 1 ? (historial.Rangos.Count - 1).ToString() : "Ninguno")</dd></div>
                        <div><dt>Promedio</dt><dd class="cifras">@Grados(e.Promedio)</dd></div>
                        <div><dt>Cumplimiento térmico</dt><dd class="cifras">@(e.PorcentajeOptimo is { } p ? $"{p:0.#} %" : "—") de las lecturas en rango óptimo</dd></div>
                        <div><dt>Tiempo con alertas de ruptura abiertas</dt><dd class="cifras">@(e.MinutosEnRuptura > 0 ? FormatoFecha.Duracion(TimeSpan.FromMinutes(e.MinutosEnRuptura)) : "—")</dd></div>
                        <div><dt>Periodo</dt><dd class="cifras">@FormatoFecha.HoraPeru(historial.Desde)[..16] a @FormatoFecha.HoraPeru(historial.Hasta)[..16]</dd></div>
                    </DatosTecnicos>
                </GraficoHistorial>
                @* La leyenda la dibuja el propio gráfico, según el modo (general o análisis). *@
            }
        </section>

        @* Alertas del periodo *@
        <section class="tarjeta seccion" aria-labelledby="titulo-alertas">
            <header class="seccion-cabecera">
                <h2 id="titulo-alertas"><Icono Nombre="campana" /> Alertas del periodo</h2>
                @if (historial.Alertas.Count > 0)
                {
                    <span class="insignia insignia-neutra">@historial.Alertas.Count</span>
                }
            </header>

            @if (historial.Alertas.Count == 0)
            {
                <p class="sin-alertas"><Icono Nombre="ok" Tamano="18" /> Sin alertas en este periodo.</p>
            }
            else
            {
                <div class="tabla-contenedor">
                    <table class="tabla tabla-alertas">
                        <thead>
                            <tr>
                                <th scope="col">Qué pasó</th>
                                <th scope="col">Empezó</th>
                                <th scope="col">Duró</th>
                                <th scope="col">Temperatura</th>
                                <th scope="col">Revisión</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in historial.Alertas)
                            {
                                <tr>
                                    <td data-titulo="Qué pasó">
                                        <span class="insignia insignia-@ClaseAlerta(a)">
                                            <Icono Nombre="@IconoAlerta(a)" Tamano="14" /> @NombreAlerta(a)
                                        </span>
                                        @if (a.DetectadaTarde)
                                        {
                                            <span class="tarde">se supo al reconectarse</span>
                                        }
                                    </td>
                                    <td data-titulo="Empezó" class="cifras">@FormatoFecha.HoraPeru(a.Inicio)[..16]</td>
                                    <td data-titulo="Duró">@(a.Fin is { } fin ? FormatoFecha.Duracion(fin - a.Inicio) : "sigue ocurriendo")</td>
                                    <td data-titulo="Temperatura" class="cifras">@(a.Tipo == TipoAlertaDto.SinSenal ? $"última conocida: {a.ValorExtremo:0.0} °C" : $"llegó a {a.ValorExtremo:0.0} °C")</td>
                                    <td data-titulo="Revisión" class="revision">
                                        @if (a.AtendidaPor is not null)
                                        {
                                            <strong><Icono Nombre="check" Tamano="14" /> Revisada por @a.AtendidaPor</strong>
                                            @if (a.CausaRuptura is not null)
                                            {
                                                <span class="causa">Causa: @a.CausaRuptura</span>
                                            }
                                            <span>@a.ObservacionAtencion</span>
                                            @if (a.TieneAnexo13)
                                            {
                                                @* Formato de notificación de ruptura, prellenado (NTS 242). *@
                                                <a class="boton boton-chico boton-excel boton-anexo" href="api/alertas/@a.Id/anexo13" download>
                                                    <Icono Nombre="descargar" Tamano="16" /> Descargar Anexo 13
                                                </a>
                                            }
                                        }
                                        else if (a.RequiereRevision)
                                        {
                                            <span class="pendiente"><Icono Nombre="advertencia" Tamano="14" /> Falta revisar</span>
                                            @* La revisión se registra en el detalle del equipo, donde está el formulario. *@
                                            <a class="revisar" href="equipos/@historial.EquipoId">Revisar</a>
                                        }
                                        else
                                        {
                                            <span class="no-aplica">No necesita revisión</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>

@code {
    // Permite abrir con un equipo elegido: /historial?equipo=2
    [SupplyParameterFromQuery(Name = "equipo")]
    public int? EquipoInicial { get; set; }

    private static readonly TimeSpan DesfasePeru = TimeSpan.FromHours(-5);

    private static readonly (string Clave, string Texto)[] Periodos =
    {
        ("24h", "Últimas 24 h"),
        ("7d", "7 días"),
        ("30d", "30 días"),
        ("personalizado", "Personalizado")
    };

    private List<EquipoResumenDto>? equipos;
    private int equipoId;
    private string periodo = "24h";

    // Días del rango personalizado (en hora de Perú).
    private DateOnly? diaDesde = DateOnly.FromDateTime(DateTime.UtcNow + DesfasePeru).AddDays(-7);
    private DateOnly? diaHasta = DateOnly.FromDateTime(DateTime.UtcNow + DesfasePeru);

    private HistorialDto? historial;
    private DateTime desde;
    private DateTime hasta;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            equipos = await Http.GetFromJsonAsync<List<EquipoResumenDto>>("api/equipos/lista") ?? new();
            if (equipos.Count == 0)
            {
                error = "No hay equipos activos.";
                return;
            }

            equipoId = equipos.Any(e => e.Id == EquipoInicial) ? EquipoInicial!.Value : equipos[0].Id;
            await CargarAsync();
        }
        catch (Exception)
        {
            error = "No se pudo cargar el historial. Revise que el servidor esté encendido.";
        }
    }

    private async Task CambiarEquipoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            equipoId = id;
            await CargarAsync();
        }
    }

    private async Task CambiarPeriodoAsync(string clave)
    {
        periodo = clave;
        if (clave != "personalizado")
        {
            await CargarAsync();
        }
    }

    // Calcula el periodo en UTC y consulta la API.
    private async Task CargarAsync()
    {
        var ahora = DateTime.UtcNow;
        (desde, hasta) = periodo switch
        {
            "7d" => (ahora.AddDays(-7), ahora),
            "30d" => (ahora.AddDays(-30), ahora),
            // Días completos en hora de Perú: de las 00:00 del primero a las 00:00 del día siguiente al último.
            "personalizado" when diaDesde is { } d && diaHasta is { } h && h >= d =>
                (d.ToDateTime(TimeOnly.MinValue) - DesfasePeru, h.AddDays(1).ToDateTime(TimeOnly.MinValue) - DesfasePeru),
            _ => (ahora.AddHours(-24), ahora)
        };

        desde = DateTime.SpecifyKind(desde, DateTimeKind.Utc);
        hasta = DateTime.SpecifyKind(hasta, DateTimeKind.Utc);

        try
        {
            error = null;
            historial = null;
            ultimaLectura = null;
            ultimaLecturaConsultada = false;
            historial = await Http.GetFromJsonAsync<HistorialDto>($"api/historial?equipoId={equipoId}&{Rango}");

            // La última lectura del equipo sirve en los dos casos: en el estado vacío (para ir a
            // esas fechas) y en el resumen (para decir si la información está al día).
            await BuscarUltimaLecturaAsync();
        }
        catch (Exception)
        {
            error = "No se pudo cargar el historial. Si eligió un rango personalizado, debe ser de 92 días como máximo.";
        }
    }

    // La última lectura del equipo (la misma consulta que usan el panel y Configuración).
    // Si falla, el estado vacío muestra su mensaje de siempre y el resumen no dice nada de ella.
    private DateTime? ultimaLectura;
    private bool ultimaLecturaConsultada;
    private bool ultimaLecturaAntigua;

    private async Task BuscarUltimaLecturaAsync()
    {
        try
        {
            var actual = await Http.GetFromJsonAsync<TemperaturaActualDto>($"api/equipos/{equipoId}/temperatura-actual");
            ultimaLectura = actual?.FechaMedicion;
            ultimaLecturaAntigua = actual is not null && EstadoEquipo.LecturaAntigua(actual);
            ultimaLecturaConsultada = true;
        }
        catch (Exception)
        {
            ultimaLectura = null;
            ultimaLecturaAntigua = false;
        }
    }

    // Día de Perú de una fecha UTC.
    private static DateOnly DiaPeru(DateTime fechaUtc) => DateOnly.FromDateTime(fechaUtc + DesfasePeru);

    // Pasa al periodo personalizado con esos días y lo carga.
    private async Task VerDiasAsync(DateOnly primero, DateOnly ultimo)
    {
        diaDesde = primero;
        diaHasta = ultimo;
        periodo = "personalizado";
        await CargarAsync();
    }

    private string Rango =>
        $"desde={Uri.EscapeDataString(desde.ToString("o"))}&hasta={Uri.EscapeDataString(hasta.ToString("o"))}";

    // Un solo archivo de Excel con tres hojas: Resumen, Lecturas y Alertas.
    // La descarga usa la misma sesión (cookie) del navegador: no necesita nada especial.
    private string UrlExcel => $"api/historial/excel?equipoId={equipoId}&{Rango}";

    // Mes de la hoja del Anexo 10. Empieza en el mes actual de Perú.
    private static DateOnly HoyPeru => DateOnly.FromDateTime(DateTime.UtcNow + DesfasePeru);
    private static string MesActual => HoyPeru.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    private DateOnly mesAnexo10 = new(HoyPeru.Year, HoyPeru.Month, 1);

    private string UrlAnexo10 => $"api/historial/anexo10?equipoId={equipoId}&mes={mesAnexo10.ToString("yyyy-MM", CultureInfo.InvariantCulture)}";

    // Con espacio que no se corta ( ): la cifra y "°C" nunca quedan en líneas distintas.
    private static string Grados(double? valor) => valor is { } v ? $"{v:0.0} °C" : "—";

    // "1,291 de 1,320": lecturas dentro del rango recomendado. Sale del porcentaje que da la API
    // (redondeado a una décima); con 1,000 lecturas o más el redondeo puede correr la cifra,
    // así que se dice "unas".
    private static string LecturasEnRango(EstadisticasHistorialDto e)
    {
        if (e.PorcentajeOptimo is not { } porcentaje || e.CantidadLecturas == 0)
        {
            return "—";
        }
        var dentro = (int)Math.Round(porcentaje * e.CantidadLecturas / 100);
        var total = e.CantidadLecturas.ToString("N0", CultureInfo.InvariantCulture);
        var exacta = e.CantidadLecturas < 1000 || porcentaje is 0 or 100;
        // "1,291 de 1,320" no se corta en el medio; si no cabe, solo "unas" queda arriba.
        return $"{(exacta ? "" : "unas ")}{dentro.ToString("N0", CultureInfo.InvariantCulture)} de {total}";
    }

    // Qué pasó, en palabras simples. "Ruptura" se conserva: es el término de la norma que usa el personal.
    private static string NombreAlerta(AlertaHistorialDto a) => a.Tipo switch
    {
        TipoAlertaDto.SinSenal => "Sin señal del equipo",
        TipoAlertaDto.SensorSinVariacion => "El sensor marca siempre lo mismo",
        TipoAlertaDto.TemperaturaAlta => a.Nivel == NivelAlertaDto.Ruptura ? "Temperatura muy alta (ruptura)" : "Temperatura algo alta",
        _ => a.Nivel == NivelAlertaDto.Ruptura ? "Temperatura muy baja (ruptura)" : "Temperatura algo baja"
    };

    private static string ClaseAlerta(AlertaHistorialDto a) =>
        a.Tipo is TipoAlertaDto.SinSenal or TipoAlertaDto.SensorSinVariacion ? "sen" : a.Nivel == NivelAlertaDto.Ruptura ? "rup" : "adv";

    // Ícono que acompaña al nombre: la gravedad no depende solo del color.
    private static string IconoAlerta(AlertaHistorialDto a) => ClaseAlerta(a) switch
    {
        "sen" => "sin-senal",
        "rup" => "ruptura",
        _ => "advertencia"
    };
}
