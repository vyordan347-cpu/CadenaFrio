@page "/historial"
@using System.Globalization
@using System.Net.Http.Json
@using CadenaFrio.Shared.Contracts
@using CadenaFrio.Web.Componentes
@using CadenaFrio.Web.Utilidades
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Historial · Cadena de Frío</PageTitle>

<main class="pagina">
    <header class="encabezado">
        <span class="encabezado-icono"><Icono Nombre="grafico" Tamano="24" /></span>
        <div class="encabezado-texto">
            <h1>Historial</h1>
            <p class="subtitulo">Temperaturas, alertas y revisiones de cada equipo, para revisar incidentes y sustentar reportes.</p>
        </div>
        @if (historial is not null)
        {
            @* El Excel trae el mismo equipo y periodo que se ven en pantalla. *@
            <a class="boton boton-primario boton-excel" href="@UrlExcel" download>
                <Icono Nombre="descargar" Tamano="18" /> Exportar a Excel
            </a>
        }
    </header>

    @* Filtros: equipo y periodo *@
    <section class="tarjeta filtros" aria-label="Filtros">
        @if (equipos is { Count: > 0 })
        {
            <label class="filtro-equipo">
                Equipo
                <select value="@equipoId" @onchange="CambiarEquipoAsync">
                    @foreach (var equipo in equipos)
                    {
                        <option value="@equipo.Id">@equipo.Nombre</option>
                    }
                </select>
            </label>
        }

        <div class="filtro-periodo">
            <span class="filtro-etiqueta" id="etiqueta-periodo">Periodo</span>
            <div class="periodos" role="group" aria-labelledby="etiqueta-periodo">
                @foreach (var (clave, texto) in Periodos)
                {
                    <button class="periodo @(periodo == clave ? "activo" : "")" aria-pressed="@(periodo == clave ? "true" : "false")"
                            @onclick="() => CambiarPeriodoAsync(clave)">@texto</button>
                }
            </div>
        </div>

        @if (periodo == "personalizado")
        {
            <div class="personalizado">
                <label>Desde <InputDate @bind-Value="diaDesde" /></label>
                <label>Hasta <InputDate @bind-Value="diaHasta" /></label>
                <button class="boton boton-primario" @onclick="CargarAsync">Ver</button>
            </div>
        }
    </section>

    @if (error is not null)
    {
        <p class="aviso aviso-error aviso-con-icono"><Icono Nombre="advertencia" Tamano="18" /> @error</p>
    }
    else if (historial is null)
    {
        <div class="esqueletos" aria-hidden="true">
            @for (var i = 0; i < 4; i++)
            {
                <span class="esqueleto esqueleto-cifra"></span>
            }
            <span class="esqueleto esqueleto-grafico"></span>
        </div>
        <p class="solo-lector" role="status">Cargando el historial…</p>
    }
    else
    {
        var e = historial.Estadisticas;

        @* De qué se trata lo que se ve: equipo, periodo y rangos vigentes. *@
        <p class="resumen-periodo cifras">
            <Icono Nombre="calendario" Tamano="16" />
            <strong>@historial.NombreEquipo</strong>
            <span>· @FormatoFecha.HoraPeru(historial.Desde)[..16] a @FormatoFecha.HoraPeru(historial.Hasta)[..16]</span>
            <span class="dato-secundario">· óptimo @historial.OptimoMinimo.ToString("0.#")–@historial.OptimoMaximo.ToString("0.#") °C, límite @historial.LimiteMinimo.ToString("0.#")–@historial.LimiteMaximo.ToString("0.#") °C</span>
        </p>

        @* Estadísticas del periodo *@
        <section class="estadisticas" aria-label="Estadísticas del periodo">
            <div class="tarjeta estadistica destacada">
                <p class="estadistica-etiqueta">Cumplimiento térmico</p>
                <p class="estadistica-valor cifras">@(e.PorcentajeOptimo is { } p ? $"{p:0.#} %" : "—")</p>
                @* Se calcula sobre las lecturas recibidas, no sobre el tiempo: si faltan datos,
                   no equivale al tiempo del periodo. *@
                <p class="estadistica-texto">de las lecturas en rango óptimo</p>
            </div>
            <div class="tarjeta estadistica">
                <p class="estadistica-etiqueta">Mínima / máxima</p>
                <p class="estadistica-valor cifras">@Grados(e.Minima) / @Grados(e.Maxima)</p>
                <p class="estadistica-texto">temperaturas extremas</p>
            </div>
            <div class="tarjeta estadistica">
                <p class="estadistica-etiqueta">Promedio</p>
                <p class="estadistica-valor cifras">@Grados(e.Promedio)</p>
                <p class="estadistica-texto">@e.CantidadLecturas.ToString("N0", CultureInfo.InvariantCulture) @(e.CantidadLecturas == 1 ? "lectura" : "lecturas")</p>
            </div>
            <div class="tarjeta estadistica @(e.CantidadRupturas > 0 ? "alerta" : "")">
                <p class="estadistica-etiqueta">Rupturas</p>
                <p class="estadistica-valor cifras">@e.CantidadRupturas</p>
                <p class="estadistica-texto">@(e.MinutosEnRuptura > 0 ? $"{FormatoFecha.Duracion(TimeSpan.FromMinutes(e.MinutosEnRuptura))} fuera del límite" : "sin tiempo fuera del límite")</p>
            </div>
        </section>

        @* Gráfico *@
        <section class="tarjeta seccion" aria-labelledby="titulo-grafico">
            <header class="seccion-cabecera">
                <h2 id="titulo-grafico"><Icono Nombre="grafico" /> Temperatura en el periodo</h2>
            </header>
            @if (e.CantidadLecturas == 0)
            {
                @* Sin lecturas: se dice cuándo fue la última (si la hay) y se ofrece ir a esas fechas.
                   No se inventa nada: la fecha sale de la última lectura guardada del equipo. *@
                <div class="estado-vacio">
                    <Icono Nombre="sin-senal" Tamano="32" />
                    <h3>Sin lecturas en este periodo</h3>
                    @if (ultimaLectura is { } ultima)
                    {
                        var dia = DiaPeru(ultima);
                        <p>
                            La última lectura de este equipo es del <strong class="cifras">@FormatoFecha.HoraPeru(ultima)[..16]</strong>
                            (@FormatoFecha.Antiguedad(ultima)).
                        </p>
                        <div class="acciones-vacio">
                            <button type="button" class="boton boton-primario" @onclick="() => VerDiasAsync(dia, dia)">
                                <Icono Nombre="calendario" Tamano="16" /> Ver el @dia.ToString("dd/MM/yyyy")
                            </button>
                            <button type="button" class="boton" @onclick="() => VerDiasAsync(dia.AddDays(-6), dia)">
                                Ver los 7 días hasta esa fecha
                            </button>
                        </div>
                    }
                    else if (ultimaLecturaConsultada)
                    {
                        <p>Este equipo todavía no ha enviado ninguna lectura.</p>
                    }
                    else
                    {
                        <p>El equipo no envió datos entre esas fechas. Pruebe con un periodo más largo.</p>
                    }
                </div>
            }
            else
            {
                <GraficoHistorial Puntos="historial.Puntos" Alertas="historial.Alertas"
                                  Desde="historial.Desde" Hasta="historial.Hasta"
                                  OptimoMinimo="historial.OptimoMinimo" OptimoMaximo="historial.OptimoMaximo"
                                  LimiteMinimo="historial.LimiteMinimo" LimiteMaximo="historial.LimiteMaximo" />
                @* La leyenda la dibuja el propio gráfico, según el modo (general o análisis). *@
            }
        </section>

        @* Alertas del periodo *@
        <section class="tarjeta seccion" aria-labelledby="titulo-alertas">
            <header class="seccion-cabecera">
                <h2 id="titulo-alertas"><Icono Nombre="campana" /> Alertas del periodo</h2>
                @if (historial.Alertas.Count > 0)
                {
                    <span class="insignia insignia-neutra">@historial.Alertas.Count</span>
                }
            </header>

            @if (historial.Alertas.Count == 0)
            {
                <p class="sin-alertas"><Icono Nombre="ok" Tamano="18" /> Sin alertas en este periodo.</p>
            }
            else
            {
                <div class="tabla-contenedor">
                    <table class="tabla tabla-alertas">
                        <thead>
                            <tr>
                                <th scope="col">Alerta</th>
                                <th scope="col">Inicio</th>
                                <th scope="col">Duración</th>
                                <th scope="col">Extremo</th>
                                <th scope="col">Revisión</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in historial.Alertas)
                            {
                                <tr>
                                    <td data-titulo="Alerta">
                                        <span class="insignia insignia-@ClaseAlerta(a)">
                                            <Icono Nombre="@IconoAlerta(a)" Tamano="14" /> @NombreAlerta(a)
                                        </span>
                                        @if (a.DetectadaTarde)
                                        {
                                            <span class="tarde">al sincronizar</span>
                                        }
                                    </td>
                                    <td data-titulo="Inicio" class="cifras">@FormatoFecha.HoraPeru(a.Inicio)[..16]</td>
                                    <td data-titulo="Duración">@(a.Fin is { } fin ? FormatoFecha.Duracion(fin - a.Inicio) : "en curso")</td>
                                    <td data-titulo="Extremo" class="cifras">@(a.Tipo == TipoAlertaDto.SinSenal ? $"última {a.ValorExtremo:0.0} °C" : $"{a.ValorExtremo:0.0} °C")</td>
                                    <td data-titulo="Revisión" class="revision">
                                        @if (a.AtendidaPor is not null)
                                        {
                                            <strong><Icono Nombre="check" Tamano="14" /> @a.AtendidaPor</strong>
                                            @if (a.CausaRuptura is not null)
                                            {
                                                <span class="causa">Causa: @a.CausaRuptura</span>
                                            }
                                            <span>@a.ObservacionAtencion</span>
                                            @if (a.TieneAnexo13)
                                            {
                                                @* Formato de notificación de ruptura, prellenado (NTS 242). *@
                                                <a class="boton boton-chico boton-excel boton-anexo" href="api/alertas/@a.Id/anexo13" download>
                                                    <Icono Nombre="descargar" Tamano="16" /> Descargar Anexo 13
                                                </a>
                                            }
                                        }
                                        else if (a.RequiereRevision)
                                        {
                                            <span class="pendiente"><Icono Nombre="advertencia" Tamano="14" /> Pendiente de revisión</span>
                                        }
                                        else
                                        {
                                            <span class="no-aplica">No requiere</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</main>

@code {
    // Permite abrir con un equipo elegido: /historial?equipo=2
    [SupplyParameterFromQuery(Name = "equipo")]
    public int? EquipoInicial { get; set; }

    private static readonly TimeSpan DesfasePeru = TimeSpan.FromHours(-5);

    private static readonly (string Clave, string Texto)[] Periodos =
    {
        ("24h", "Últimas 24 h"),
        ("7d", "7 días"),
        ("30d", "30 días"),
        ("personalizado", "Personalizado")
    };

    private List<EquipoResumenDto>? equipos;
    private int equipoId;
    private string periodo = "24h";

    // Días del rango personalizado (en hora de Perú).
    private DateOnly? diaDesde = DateOnly.FromDateTime(DateTime.UtcNow + DesfasePeru).AddDays(-7);
    private DateOnly? diaHasta = DateOnly.FromDateTime(DateTime.UtcNow + DesfasePeru);

    private HistorialDto? historial;
    private DateTime desde;
    private DateTime hasta;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            equipos = await Http.GetFromJsonAsync<List<EquipoResumenDto>>("api/equipos/lista") ?? new();
            if (equipos.Count == 0)
            {
                error = "No hay equipos activos.";
                return;
            }

            equipoId = equipos.Any(e => e.Id == EquipoInicial) ? EquipoInicial!.Value : equipos[0].Id;
            await CargarAsync();
        }
        catch (Exception)
        {
            error = "No se pudo cargar el historial. Revise que el servidor esté encendido.";
        }
    }

    private async Task CambiarEquipoAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            equipoId = id;
            await CargarAsync();
        }
    }

    private async Task CambiarPeriodoAsync(string clave)
    {
        periodo = clave;
        if (clave != "personalizado")
        {
            await CargarAsync();
        }
    }

    // Calcula el periodo en UTC y consulta la API.
    private async Task CargarAsync()
    {
        var ahora = DateTime.UtcNow;
        (desde, hasta) = periodo switch
        {
            "7d" => (ahora.AddDays(-7), ahora),
            "30d" => (ahora.AddDays(-30), ahora),
            // Días completos en hora de Perú: de las 00:00 del primero a las 00:00 del día siguiente al último.
            "personalizado" when diaDesde is { } d && diaHasta is { } h && h >= d =>
                (d.ToDateTime(TimeOnly.MinValue) - DesfasePeru, h.AddDays(1).ToDateTime(TimeOnly.MinValue) - DesfasePeru),
            _ => (ahora.AddHours(-24), ahora)
        };

        desde = DateTime.SpecifyKind(desde, DateTimeKind.Utc);
        hasta = DateTime.SpecifyKind(hasta, DateTimeKind.Utc);

        try
        {
            error = null;
            historial = null;
            ultimaLectura = null;
            ultimaLecturaConsultada = false;
            historial = await Http.GetFromJsonAsync<HistorialDto>($"api/historial?equipoId={equipoId}&{Rango}");

            if (historial?.Estadisticas.CantidadLecturas == 0)
            {
                await BuscarUltimaLecturaAsync();
            }
        }
        catch (Exception)
        {
            error = "No se pudo cargar el historial. Si eligió un rango personalizado, debe ser de 92 días como máximo.";
        }
    }

    // Para el estado vacío: la fecha de la última lectura del equipo (la misma consulta que
    // usan el panel y Configuración). Si falla, se muestra el mensaje de siempre.
    private DateTime? ultimaLectura;
    private bool ultimaLecturaConsultada;

    private async Task BuscarUltimaLecturaAsync()
    {
        try
        {
            var actual = await Http.GetFromJsonAsync<TemperaturaActualDto>($"api/equipos/{equipoId}/temperatura-actual");
            ultimaLectura = actual?.FechaMedicion;
            ultimaLecturaConsultada = true;
        }
        catch (Exception)
        {
            ultimaLectura = null;
        }
    }

    // Día de Perú de una fecha UTC.
    private static DateOnly DiaPeru(DateTime fechaUtc) => DateOnly.FromDateTime(fechaUtc + DesfasePeru);

    // Pasa al periodo personalizado con esos días y lo carga.
    private async Task VerDiasAsync(DateOnly primero, DateOnly ultimo)
    {
        diaDesde = primero;
        diaHasta = ultimo;
        periodo = "personalizado";
        await CargarAsync();
    }

    private string Rango =>
        $"desde={Uri.EscapeDataString(desde.ToString("o"))}&hasta={Uri.EscapeDataString(hasta.ToString("o"))}";

    // Un solo archivo de Excel con tres hojas: Resumen, Lecturas y Alertas.
    // La descarga usa la misma sesión (cookie) del navegador: no necesita nada especial.
    private string UrlExcel => $"api/historial/excel?equipoId={equipoId}&{Rango}";

    private static string Grados(double? valor) => valor is { } v ? $"{v:0.0} °C" : "—";

    private static string NombreAlerta(AlertaHistorialDto a) => a.Tipo switch
    {
        TipoAlertaDto.SinSenal => "Sin señal",
        TipoAlertaDto.SensorSinVariacion => "Sensor sin variación",
        TipoAlertaDto.TemperaturaAlta => a.Nivel == NivelAlertaDto.Ruptura ? "Ruptura (alta)" : "Advertencia (alta)",
        _ => a.Nivel == NivelAlertaDto.Ruptura ? "Ruptura (baja)" : "Advertencia (baja)"
    };

    private static string ClaseAlerta(AlertaHistorialDto a) =>
        a.Tipo is TipoAlertaDto.SinSenal or TipoAlertaDto.SensorSinVariacion ? "sen" : a.Nivel == NivelAlertaDto.Ruptura ? "rup" : "adv";

    // Ícono que acompaña al nombre: la gravedad no depende solo del color.
    private static string IconoAlerta(AlertaHistorialDto a) => ClaseAlerta(a) switch
    {
        "sen" => "sin-senal",
        "rup" => "ruptura",
        _ => "advertencia"
    };
}
